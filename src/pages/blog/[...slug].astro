---
/**
 * A blog post in English. The Slovak twin of this route lives at
 * src/pages/sk/blog/[...slug].astro; both render the same component.
 */
import BlogPost from '../../components/pages/BlogPost.astro';
import { entrySlug, getEntryAlternates, getLocalizedCollection } from '../../i18n/content';

const LANG = 'en' as const;

export async function getStaticPaths() {
  const posts = await getLocalizedCollection('blog', 'en');
  return Promise.all(
    posts.map(async (post) => ({
      params: { slug: entrySlug(post) },
      props: { post, alternates: await getEntryAlternates('blog', post, '/blog') },
    }))
  );
}

const { post, alternates } = Astro.props;
---

<BlogPost post={post} lang={LANG} alternates={alternates} />
