---
/**
 * A project page in English. The Slovak twin of this route lives at
 * src/pages/sk/projects/[...slug].astro; both render the same component.
 */
import ProjectDetail from '../../components/pages/ProjectDetail.astro';
import { entrySlug, getEntryAlternates, getLocalizedCollection } from '../../i18n/content';

const LANG = 'en' as const;

export async function getStaticPaths() {
  const projects = await getLocalizedCollection('projects', 'en');
  return Promise.all(
    projects.map(async (project) => ({
      params: { slug: entrySlug(project) },
      props: { project, alternates: await getEntryAlternates('projects', project, '/projects') },
    }))
  );
}

const { project, alternates } = Astro.props;
---

<ProjectDetail project={project} lang={LANG} alternates={alternates} />
