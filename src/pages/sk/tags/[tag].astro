---
/** Posts carrying one tag, in Slovak. */
import TagPage from '../../../components/pages/TagPage.astro';
import { getLocalizedCollection } from '../../../i18n/content';
import { getTaxonomyAlternates } from '../../../i18n/taxonomy';
import { slugify } from '../../../utils/slugify';

const LANG = 'sk' as const;

export async function getStaticPaths() {
  const posts = await getLocalizedCollection('blog', 'sk');
  const tags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))];
  return Promise.all(
    tags.map(async (tag) => ({
      params: { tag: slugify(tag) },
      props: {
        tag,
        posts: posts.filter((p) => p.data.tags?.includes(tag)),
        alternates: await getTaxonomyAlternates('tags', tag, 'sk'),
      },
    }))
  );
}

const { tag, posts, alternates } = Astro.props;
---

<TagPage tag={tag} posts={posts} lang={LANG} alternates={alternates} />
