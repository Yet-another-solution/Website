---
/** One series' posts in order, in Slovak. */
import SeriesPage from '../../../components/pages/SeriesPage.astro';
import { getLocalizedCollection } from '../../../i18n/content';
import { getTaxonomyAlternates } from '../../../i18n/taxonomy';
import { slugify } from '../../../utils/slugify';

const LANG = 'sk' as const;

export async function getStaticPaths() {
  const posts = await getLocalizedCollection('blog', 'sk');
  const seriesNames = [...new Set(posts.flatMap((p) => p.data.series ?? []))];
  return Promise.all(
    seriesNames.map(async (name) => ({
      params: { series: slugify(name) },
      props: {
        seriesName: name,
        posts: posts
          .filter((p) => p.data.series?.includes(name))
          .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0)),
        alternates: await getTaxonomyAlternates('series', name, 'sk'),
      },
    }))
  );
}

const { seriesName, posts, alternates } = Astro.props;
---

<SeriesPage seriesName={seriesName} posts={posts} lang={LANG} alternates={alternates} />
