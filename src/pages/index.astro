---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => !data.draft);
---

<BaseLayout isHome={true}>
  <!-- Hero -->
  <div class="vh-100 w-100 dark d-flex" id="home">
    <div class="dark-bg w-100 h-100">
      <div class="white-square">
        <div class="lr-ws"></div>
        <div class="lr-ws-center">
          <div class="lr-ws d-flex flex-column" id="hero-frame" style="height:100%">
            <div class="s-text">
              <h1 class="rubik display-1 h1 dark-text text-center">Y-A-S</h1>
            </div>
            <div class="d-flex h-100">
              <div class="col-2 d-flex justify-content-start align-items-end">
                <img src="/img/Squares.png" alt="Y-A-S Logo" class="img-fluid" id="squares-fallback" style="max-height: 100%; object-fit: contain;" />
              </div>
              <div class="col-8 d-flex justify-content-center align-items-start">
                <div>
                  <div class="d-flex flex-column justify-content-center align-items-center mb-2">
                    <hr class="w-50" style="border-color: #333C4D" />
                  </div>
                  <div class="jet-brains-mono dark-text" style="transform: rotate(90deg); font-size: 2rem;">
                    Solution <br />
                    Another <br />
                    Yet
                  </div>
                </div>
              </div>
              <div class="col-2 d-flex flex-column justify-content-end align-items-center pb-3">
                <div class="dark-bg rounded-pill p-2 d-flex flex-column gap-4 align-items-center" style="box-shadow: inset 2px 2px 4px rgba(0,0,0,0.3), inset -2px -2px 4px rgba(255,255,255,0.1); width: 60px;">
                  <a href="https://github.com/Yet-another-solution" target="_blank" class="btn btn-light rounded-circle p-2" style="width: 40px; height: 40px; display: flex; justify-content: center; align-items: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                    </svg>
                  </a>
                  <div class="d-flex flex-column" style="width: 45px; height: 135px;">
                    <a href="/projects/" class="btn btn-light d-flex justify-content-center align-items-center" style="flex: 1; border-radius: 25px 25px 0 0; border-bottom: 1px solid #333C4D;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h4.672a2 2 0 0 1 2 2l-.04.87a1.99 1.99 0 0 0-.342-.87A1 1 0 0 0 15.172 4H9.828a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 6.172 2H2.5a1 1 0 0 0-1 1l.04.87a1.99 1.99 0 0 0-.342.87z"/>
                        <path d="M2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H2zm0 1h12a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/>
                      </svg>
                    </a>
                    <a href="/blog/" class="btn btn-light d-flex justify-content-center align-items-center" style="flex: 1; border-radius: 0; border-bottom: 1px solid #333C4D; border-top: 1px solid #333C4D;" title="Read our blog">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
                        <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2z"/>
                        <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1z"/>
                      </svg>
                    </a>
                    <a href="#what" class="btn btn-light d-flex justify-content-center align-items-center" style="flex: 1; border-radius: 0 0 25px 25px; border-top: 1px solid #333C4D;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="lr-ws"></div>
      </div>
    </div>
  </div>

  <!-- Transition line -->
  <div id="start"></div>

  <!-- Content panel -->
  <div class="yas-page-canvas">
    <div class="yas-panel">
      <div class="yas-panel-inner" id="what">

        <!-- Intro -->
        <div class="homepage-intro fade-in-up">
          <div class="row align-items-center g-5">
            <div class="col-lg-6">
              <span class="intro-label">Yet Another Solution</span>
              <h2 class="intro-heading">We build software<span class="accent-dot">.</span></h2>
              <p class="intro-body">
                A team of developers crafting full-stack applications with modern tools — from backend APIs to polished web interfaces.
              </p>
              <div class="tech-badges mb-4">
                <span class="tech-badge">C#</span>
                <span class="tech-badge">Blazor</span>
                <span class="tech-badge">PostgreSQL</span>
                <span class="tech-badge">Azure</span>
                <span class="tech-badge">GitHub</span>
              </div>
              <div class="d-flex gap-3 flex-wrap">
                <a href="/projects/" class="cta-btn-primary">View Projects</a>
                <a href="/contact/" class="cta-btn-outline">Contact Us</a>
              </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
              <div class="tech-stack-wrapper">
                <img src="/img/TechStack.png" class="img-fluid tech-stack-img" alt="Technology stack: C#, Blazor, PostgreSQL, GitHub" loading="lazy" />
              </div>
            </div>
          </div>
        </div>

        <!-- How We Work -->
        <div class="yas-rule"></div>
        <div class="reveal-section fade-in-up">
          <span class="intro-label">How We Work</span>
          <h2 class="blog-cta-heading">From idea to shipped.</h2>
          <p class="blog-cta-body" style="max-width: 640px;">
            We move in small, focused iterations — spec, build, review, ship. Every project gets a clear
            architecture, tested code, and documentation your team can actually use.
          </p>
          <div class="d-flex gap-2 flex-wrap mt-3">
            <span class="outline-badge">Discovery</span>
            <span class="outline-badge">Build</span>
            <span class="outline-badge outline-badge--blue">Review</span>
            <span class="outline-badge outline-badge--blue">Ship</span>
          </div>
        </div>

        <!-- Talks & Presentations -->
        <div class="yas-rule"></div>
        <div class="reveal-section fade-in-up">
          <span class="intro-label">Talks &amp; Presentations</span>
          <h2 class="blog-cta-heading">We talk shop, too.</h2>
          <p class="blog-cta-body" style="max-width: 640px;">
            Conference talks, meetups, and workshop sessions from the team — mostly on Blazor, .NET, and the
            hackathons we help run.
          </p>
          <div class="talks-list mt-4">
            <div class="talk-item">
              <span class="talk-date">2024</span>
              <div>
                <h3 class="talk-title">Building Real-Time Apps with Blazor Server</h3>
                <p class="talk-venue">Hack Esbjerg — IT Hackathon</p>
              </div>
            </div>
            <div class="talk-item">
              <span class="talk-date">2024</span>
              <div>
                <h3 class="talk-title">PostgreSQL Performance Patterns for .NET Developers</h3>
                <p class="talk-venue">Cod3rs Community Meetup</p>
              </div>
            </div>
            <div class="talk-item">
              <span class="talk-date">2023</span>
              <div>
                <h3 class="talk-title">From Zero to Cipher: Designing Hack The Flag</h3>
                <p class="talk-venue">Nordic DevFest</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Why Y-A-S -->
        <div class="yas-rule"></div>
        <div class="reveal-section fade-in-up">
          <span class="intro-label">Why Y-A-S</span>
          <h2 class="blog-cta-heading">Small team, real ownership.</h2>
          <p class="blog-cta-body" style="max-width: 640px;">
            No hand-offs between account managers and engineers — you talk directly to the people writing
            your code. We pick boring, reliable technology so your product stays maintainable long after launch.
          </p>
          <div class="d-flex gap-2 flex-wrap mt-3">
            <span class="outline-badge">.NET &amp; C#</span>
            <span class="outline-badge">PostgreSQL</span>
            <span class="outline-badge outline-badge--blue">Cloud-native</span>
            <span class="outline-badge outline-badge--blue">CI/CD</span>
          </div>
        </div>

        <!-- Blog CTA -->
        <div class="yas-rule"></div>
        <div class="blog-cta-section reveal-section fade-in-up">
          <div class="row align-items-center g-4">
            <div class="col-md-8">
              <span class="intro-label">From the team</span>
              <h2 class="blog-cta-heading">Read our Blog</h2>
              <p class="blog-cta-body">
                Insights, tutorials, and deep dives on software development, web technologies, and innovative solutions.
              </p>
              <div class="d-flex gap-2 flex-wrap mt-3">
                <span class="outline-badge">Blazor</span>
                <span class="outline-badge">C#</span>
                <span class="outline-badge outline-badge--blue">Web Development</span>
                <span class="outline-badge outline-badge--blue">Tutorials</span>
              </div>
            </div>
            <div class="col-md-4 text-center mt-3 mt-md-0">
              <a href="/blog/" class="cta-btn-primary cta-btn-large">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                  <path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
                  <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2z"/>
                  <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1z"/>
                </svg>
                Explore Blog
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <style>
    .talks-list { display: flex; flex-direction: column; gap: 1rem; }
    .talk-item {
      display: flex;
      align-items: baseline;
      gap: 1.25rem;
      padding: 1rem 1.25rem;
      border: 1px solid var(--border-color);
      border-left: 3px solid var(--primary-color);
    }
    .talk-date {
      font-family: 'Rubik Mono One', monospace;
      font-size: 0.85rem;
      color: var(--primary-color);
      flex-shrink: 0;
      width: 3rem;
    }
    .talk-title { font-size: 1rem; font-weight: 700; color: var(--main-dark-color); margin: 0 0 0.25rem; }
    .talk-venue { font-size: 0.85rem; color: var(--main-dark-text-color); margin: 0; }
  </style>

  <script>
    import * as THREE from 'three';

    const fallbackImg = document.getElementById('squares-fallback');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (fallbackImg && !reduceMotion) {
      try {
        initHeroSquares(fallbackImg);
      } catch (err) {
        console.warn('Hero squares animation unavailable:', err);
      }
    }

    function initHeroSquares(fallbackImg: HTMLElement) {
      // Colors and proportions match the Y-A-S brand mark (public/img/Squares.svg):
      // each row is a light rounded-square border behind a smaller colored one.
      const neutral = 0xe5e2e1;
      const rows = [
        { inner: 0xe5e2e1 },
        { inner: 0x66cc8a },
        { inner: 0x377cfb },
        { inner: 0xea5234 },
        { inner: 0x333c4d },
      ];
      const bgColor = 0x333c4d;
      const baseSize = 100;
      const innerSize = baseSize * 0.91;
      const outerRadius = baseSize * 0.0909;
      const innerRadius = innerSize * 0.0789;

      function roundedSquareGeometry(size: number, radius: number) {
        const s = size / 2;
        const r = Math.min(radius, s);
        const shape = new THREE.Shape();
        shape.moveTo(-s + r, -s);
        shape.lineTo(s - r, -s);
        shape.quadraticCurveTo(s, -s, s, -s + r);
        shape.lineTo(s, s - r);
        shape.quadraticCurveTo(s, s, s - r, s);
        shape.lineTo(-s + r, s);
        shape.quadraticCurveTo(-s, s, -s, s - r);
        shape.lineTo(-s, -s + r);
        shape.quadraticCurveTo(-s, -s, -s + r, -s);
        return new THREE.ShapeGeometry(shape);
      }

      const outerGeometry = roundedSquareGeometry(baseSize, outerRadius);
      const innerGeometry = roundedSquareGeometry(innerSize, innerRadius);

      let width = window.innerWidth;
      let height = window.innerHeight;
      const heroFrame = document.getElementById('hero-frame');

      const canvas = document.createElement('canvas');
      canvas.setAttribute('aria-hidden', 'true');
      Object.assign(canvas.style, {
        position: 'fixed',
        inset: '0',
        width: '100vw',
        height: '100vh',
        zIndex: '2000',
        pointerEvents: 'none',
      });
      document.body.appendChild(canvas);

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(width, height);
      renderer.setClearColor(bgColor, 1);

      const scene = new THREE.Scene();
      const camera = new THREE.OrthographicCamera(0, width, 0, height, 0.1, 2000);
      camera.position.z = 100;

      let centerX = width / 2;
      let centerY = height / 2;
      let targets = computeTargets();

      const neutralColor = new THREE.Color(neutral);

      const groups = rows.map(({ inner }, i) => {
        const group = new THREE.Group();
        const outerMesh = new THREE.Mesh(
          outerGeometry,
          new THREE.MeshBasicMaterial({ color: neutral, side: THREE.DoubleSide })
        );
        const innerMesh = new THREE.Mesh(
          innerGeometry,
          new THREE.MeshBasicMaterial({ color: neutral, transparent: true, side: THREE.DoubleSide })
        );
        innerMesh.position.z = 0.1;
        group.add(outerMesh, innerMesh);
        group.userData.innerMesh = innerMesh;
        group.userData.outerMesh = outerMesh;
        group.userData.finalColor = new THREE.Color(inner);
        // Every piece starts stacked on the same spot, unrotated and neutral —
        // together they read as a single plain square before exploding apart.
        group.position.set(centerX, centerY, i * 0.5);
        group.rotation.set(0, 0, 0);
        group.scale.set(targets[i].scale, targets[i].scale, 1);
        scene.add(group);
        return group;
      });

      // hide the static fallback image now that the canvas is confirmed to work
      fallbackImg.style.visibility = 'hidden';

      // One entry per content section below the hero, in document order.
      // Squares vanish top-down (row 4, the navy one, first) as each section
      // scrolls into view — row 0 (the neutral one) always stays.
      const revealSections = Array.from(document.querySelectorAll('.reveal-section'));

      function computeTargets() {
        const rect = fallbackImg.getBoundingClientRect();
        const frameRect = heroFrame ? heroFrame.getBoundingClientRect() : rect;
        const scale = (rect.width * 1.05) / baseSize;
        const step = rect.height * 0.15;
        // Anchor to the bordered frame's left edge, not the raw column edge,
        // so the stack sits inset with the rest of the hero content instead
        // of bleeding off the edge of the square.
        const halfDiamond = (scale * baseSize * Math.SQRT2) / 2;
        const inset = 24;
        const baseX = frameRect.left + inset + halfDiamond;
        const baseY = rect.top + rect.height * 0.85;
        return rows.map((_, i) => ({
          x: baseX,
          y: baseY - i * step,
          scale,
        }));
      }

      function ease(t: number) {
        return 1 - Math.pow(1 - t, 3);
      }

      const start = performance.now();
      const holdMs = 500;
      const animMs = 1400;
      let settled = false;
      // Captured once the explosion settles (and refreshed on resize) so the
      // stack stays put on screen instead of scrolling away with the page.
      let stickyTargets = targets;

      window.addEventListener('resize', () => {
        width = window.innerWidth;
        height = window.innerHeight;
        renderer.setSize(width, height);
        camera.right = width;
        camera.bottom = height;
        camera.updateProjectionMatrix();
        centerX = width / 2;
        centerY = height / 2;
        targets = computeTargets();
        if (settled) stickyTargets = computeTargets();
      });

      // How far each square has progressed toward "leaving", 0 (fully present)
      // to 1 (gone), driven by how far its mapped section has scrolled into
      // view rather than a one-shot trigger — so it scrubs cleanly both ways.
      function computeRemoval() {
        const removal = [0, 0, 0, 0, 0];
        const startLine = height * 0.9;
        const endLine = height * 0.3;
        revealSections.forEach((section, k) => {
          const squareIndex = 4 - k;
          if (squareIndex < 0) return;
          const rect = section.getBoundingClientRect();
          const t = (startLine - rect.top) / (startLine - endLine);
          removal[squareIndex] = Math.min(1, Math.max(0, t));
        });
        // Row 0 (neutral) has no section of its own, so it would otherwise
        // stay pinned on screen forever — including on top of the footer.
        // Fade it out as the last section's tail end scrolls through, using
        // its top edge (its bottom rarely clears the fold on a short page).
        const lastSection = revealSections[revealSections.length - 1];
        if (lastSection) {
          const rect = lastSection.getBoundingClientRect();
          const t = (height * 0.45 - rect.top) / (height * 0.35);
          removal[0] = Math.min(1, Math.max(0, t));
        }
        return removal;
      }

      function animate(now: number) {
        requestAnimationFrame(animate);

        if (!settled) {
          const elapsed = now - start;
          if (elapsed < holdMs) {
            renderer.setClearAlpha(1);
            groups.forEach((group, i) => {
              group.scale.set(targets[i].scale, targets[i].scale, 1);
            });
          } else {
            const t = Math.min((elapsed - holdMs) / animMs, 1);
            const e = ease(t);
            renderer.setClearAlpha(1 - e);
            groups.forEach((group, i) => {
              const tgt = targets[i];
              group.position.x = centerX + (tgt.x - centerX) * e;
              group.position.y = centerY + (tgt.y - centerY) * e;
              group.rotation.z = e * (Math.PI / 4);
              group.scale.set(tgt.scale, tgt.scale, 1);
              const inner = group.userData.innerMesh;
              inner.material.color.copy(neutralColor).lerp(group.userData.finalColor, e);
            });
            if (t >= 1) {
              settled = true;
              stickyTargets = computeTargets();
            }
          }
        } else {
          const wobble = Math.sin(window.scrollY * 0.002) * 0.3;
          const removal = computeRemoval();
          groups.forEach((group, i) => {
            const base = stickyTargets[i];
            const dir = i % 2 === 0 ? 1 : -1;
            const leave = ease(removal[i]);
            group.position.set(base.x, base.y - leave * 220, group.position.z);
            group.rotation.set(0, 0, Math.PI / 4 + dir * wobble + leave * 0.6);
            const s = base.scale * (1 - leave * 0.5);
            group.scale.set(s, s, 1);
            const opacity = 1 - leave;
            group.userData.innerMesh.material.transparent = true;
            group.userData.innerMesh.material.opacity = opacity;
            group.userData.outerMesh.material.transparent = true;
            group.userData.outerMesh.material.opacity = opacity;
          });
        }

        renderer.render(scene, camera);
      }

      requestAnimationFrame(animate);
    }
  </script>
</BaseLayout>
