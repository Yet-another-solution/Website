---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with the Y-A-S team." section="contact">
  <div class="yas-page-canvas">
    <div class="yas-panel">
      <div class="yas-panel-inner">

        <div class="yas-panel-header">
          <h1 class="yas-panel-title">Contact</h1>
        </div>

        <div class="post-content" style="max-width: 600px;">
          <h2>Get in Touch</h2>
          <p>
            The best way to reach us is through GitHub. We're always open to collaboration,
            questions, and feedback.
          </p>
          <p>
            <strong>GitHub:</strong>{' '}
            <a href="https://github.com/Yet-another-solution" target="_blank">
              Yet-another-solution
            </a>
          </p>
          <div class="yas-rule"></div>
          <p style="color: var(--main-dark-text-color); font-size: 0.9rem;">
            Looking forward to connecting with you.
          </p>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>
