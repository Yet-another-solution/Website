---
// Bootstrap and the fonts are bundled from npm rather than a CDN, so a page
// view sends the visitor's IP address to nobody but our own host. They must
// stay above global.css, whose rules override Bootstrap's.
import 'bootstrap/dist/css/bootstrap.min.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/400-italic.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/500-italic.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/jetbrains-mono/700-italic.css';
import '@fontsource/rubik-mono-one/400.css';
import '../styles/global.css';
import { company } from '../company';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import {
  defaultLang,
  languages,
  localeTags,
  ogLocales,
  useTranslations,
  type Lang,
} from '../i18n/ui';
import { localizePath, switchLangPath } from '../i18n/routing';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isHome?: boolean;
  section?: string;
  lang?: Lang;
  /**
   * Per-language URLs for this exact page, feeding both the switcher and the
   * hreflang tags. Pages whose translated slug differs (blog posts, projects)
   * pass them explicitly; everything else defaults to a `/sk/` prefix swap.
   * A null entry means "not translated" — no alternate is advertised.
   */
  alternates?: Partial<Record<Lang, string | null>>;
}

const {
  title,
  description,
  image = '/img/Logo.png',
  isHome = false,
  section = '',
  lang = defaultLang,
  alternates = {},
} = Astro.props;

const t = useTranslations(lang);

const fullTitle = isHome ? 'Y-A-S' : `${title} | Y-A-S`;
const pageDescription = description ?? t('site.description');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const langCodes = Object.keys(languages) as Lang[];

// Resolved once so the switcher and the hreflang tags can never disagree.
const alternateHrefs = Object.fromEntries(
  langCodes.map((code) => [
    code,
    alternates[code] === undefined ? switchLangPath(Astro.url.pathname, code) : alternates[code],
  ])
) as Record<Lang, string | null>;

const hreflangLinks = langCodes
  .filter((code) => alternateHrefs[code])
  .map((code) => ({
    hreflang: localeTags[code],
    href: new URL(alternateHrefs[code] as string, Astro.site).href,
  }));

const xDefault = alternateHrefs[defaultLang]
  ? new URL(alternateHrefs[defaultLang] as string, Astro.site).href
  : null;

const navItems = [
  { key: 'nav.home', path: '/', section: 'home' },
  { key: 'nav.blog', path: '/blog/', section: 'blog' },
  { key: 'nav.projects', path: '/projects/', section: 'projects' },
  { key: 'nav.contact', path: '/contact/', section: 'contact' },
] as const;
---

<!DOCTYPE html>
<html lang={localeTags[lang]}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta name="description" content={pageDescription} />
  <meta name="author" content="Y-A-S Team" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalURL} />

  {hreflangLinks.map(({ hreflang, href }) => (
    <link rel="alternate" hreflang={hreflang} href={href} />
  ))}
  {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

  <meta property="og:type" content={isHome ? 'website' : 'article'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={ogLocales[lang]} />
  {langCodes
    .filter((code) => code !== lang && alternateHrefs[code])
    .map((code) => <meta property="og:locale:alternate" content={ogLocales[code]} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" href="/img/Logo.png" type="image/png" />
  <title>{fullTitle}</title>

  <slot name="head" />
</head>
<body>
  {isHome ? (
    <LanguageSwitcher lang={lang} hrefs={alternateHrefs} variant="floating" />
  ) : (
    <nav class="navbar navbar-expand-lg navbar-dark yas-navbar">
      <div class="yas-container yas-navbar-inner">
        <a class="yas-navbar-brand rubik" href={localizePath('/', lang)} aria-label={t('nav.homeAria')}>Y-A-S</a>
        <div class="d-flex align-items-center gap-2 ms-auto order-lg-3">
          <LanguageSwitcher lang={lang} hrefs={alternateHrefs} />
          <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label={t('nav.toggle')}>
            <span class="navbar-toggler-icon"></span>
          </button>
        </div>
        <div class="collapse navbar-collapse order-lg-2" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            {navItems.map((item) => (
              <li class="nav-item">
                <a
                  class={`nav-link yas-nav-link${section === item.section ? ' yas-nav-active' : ''}`}
                  href={localizePath(item.path, lang)}
                  aria-current={section === item.section ? 'page' : undefined}
                >
                  {t(item.key)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </nav>
  )}

  <slot />

  <footer class="yas-footer">
    <div class="yas-container">
      <div class="footer-top">
        <div class="footer-brand">
          <span class="rubik footer-logo">Y-A-S</span>
          <p class="footer-description">{t('site.description')}</p>
          <a href="https://github.com/Yet-another-solution" target="_blank" rel="noopener" class="footer-gh">
            Yet-another-solution
          </a>
        </div>
        <div>
          <h2 class="footer-section-title">{t('footer.navigation')}</h2>
          <ul class="list-unstyled footer-links">
            {navItems.map((item) => (
              <li><a href={localizePath(item.path, lang)}>{t(item.key)}</a></li>
            ))}
            <li><a href={localizePath('/privacy/', lang)}>{t('footer.privacy')}</a></li>
          </ul>
        </div>
        <div>
          <h2 class="footer-section-title">{t('footer.team')}</h2>
          <ul class="list-unstyled footer-links">
            <li><a href="https://github.com/MatejMa2ur" target="_blank" rel="noopener">MatejMa2ur</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="footer-legal">
          &copy; {new Date().getFullYear()} {company.name} &middot; {t('company.cvr')} {company.cvr} &middot;
          {company.street}, {company.city}, {t('company.country')} &middot;
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </p>
        <p class="footer-built">{t('footer.builtWith')}</p>
      </div>
    </div>
  </footer>

  <script>
    // Only the navbar toggler needs Bootstrap's JS.
    import 'bootstrap/js/dist/collapse';
  </script>
</body>
</html>
