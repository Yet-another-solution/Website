---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import {
  defaultLang,
  languages,
  localeTags,
  ogLocales,
  useTranslations,
  type Lang,
} from '../i18n/ui';
import { localizePath, switchLangPath } from '../i18n/routing';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isHome?: boolean;
  section?: string;
  lang?: Lang;
  /**
   * Per-language URLs for this exact page, feeding both the switcher and the
   * hreflang tags. Pages whose translated slug differs (blog posts, projects)
   * pass them explicitly; everything else defaults to a `/sk/` prefix swap.
   * A null entry means "not translated" — no alternate is advertised.
   */
  alternates?: Partial<Record<Lang, string | null>>;
}

const {
  title,
  description,
  image = '/img/Logo.png',
  isHome = false,
  section = '',
  lang = defaultLang,
  alternates = {},
} = Astro.props;

const t = useTranslations(lang);

const fullTitle = isHome ? 'Y-A-S' : `${title} | Y-A-S`;
const pageDescription = description ?? t('site.description');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const langCodes = Object.keys(languages) as Lang[];

// Resolved once so the switcher and the hreflang tags can never disagree.
const alternateHrefs = Object.fromEntries(
  langCodes.map((code) => [
    code,
    alternates[code] === undefined ? switchLangPath(Astro.url.pathname, code) : alternates[code],
  ])
) as Record<Lang, string | null>;

const hreflangLinks = langCodes
  .filter((code) => alternateHrefs[code])
  .map((code) => ({
    hreflang: localeTags[code],
    href: new URL(alternateHrefs[code] as string, Astro.site).href,
  }));

const xDefault = alternateHrefs[defaultLang]
  ? new URL(alternateHrefs[defaultLang] as string, Astro.site).href
  : null;

const navItems = [
  { key: 'nav.home', path: '/', section: 'home' },
  { key: 'nav.blog', path: '/blog/', section: 'blog' },
  { key: 'nav.projects', path: '/projects/', section: 'projects' },
  { key: 'nav.contact', path: '/contact/', section: 'contact' },
] as const;
---

<!DOCTYPE html>
<html lang={localeTags[lang]}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta name="description" content={pageDescription} />
  <meta name="author" content="Y-A-S Team" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalURL} />

  {hreflangLinks.map(({ hreflang, href }) => (
    <link rel="alternate" hreflang={hreflang} href={href} />
  ))}
  {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

  <meta property="og:type" content={isHome ? 'website' : 'article'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={ogLocales[lang]} />
  {langCodes
    .filter((code) => code !== lang && alternateHrefs[code])
    .map((code) => <meta property="og:locale:alternate" content={ogLocales[code]} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Rubik+Mono+One&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

  <link rel="icon" href="/img/Logo.png" type="image/png" />
  <title>{fullTitle}</title>

  <slot name="head" />
</head>
<body>
  {isHome ? (
    <LanguageSwitcher lang={lang} hrefs={alternateHrefs} variant="floating" />
  ) : (
    <nav class="navbar navbar-expand-lg navbar-dark yas-navbar">
      <div class="container-fluid px-4">
        <a class="navbar-brand yas-navbar-brand" href={localizePath('/', lang)} aria-label={t('nav.homeAria')}>
          <img src="/img/Logo.png" alt="Y-A-S Logo" height="30" width="30" class="d-inline-block align-text-top yas-logo" loading="eager" />
          <span class="rubik">Y-A-S</span>
        </a>
        <div class="d-flex align-items-center gap-2 ms-auto order-lg-3">
          <LanguageSwitcher lang={lang} hrefs={alternateHrefs} />
          <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label={t('nav.toggle')}>
            <span class="navbar-toggler-icon"></span>
          </button>
        </div>
        <div class="collapse navbar-collapse order-lg-2" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            {navItems.map((item) => (
              <li class="nav-item">
                <a
                  class={`nav-link yas-nav-link${section === item.section ? ' yas-nav-active' : ''}`}
                  href={localizePath(item.path, lang)}
                >
                  {t(item.key)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </nav>
  )}

  <slot />

  <footer class="yas-footer mt-5">
    <div class="container py-5">
      <div class="row g-4">
        <div class="col-md-5">
          <div class="d-flex align-items-center mb-3 gap-2">
            <img src="/img/Logo.png" alt="Y-A-S Logo" height="32" width="32" loading="lazy" />
            <span class="rubik fs-5 text-white">Y-A-S</span>
          </div>
          <p class="jet-brains-mono footer-description">
            {t('site.description')}
          </p>
          <a href="https://github.com/Yet-another-solution" target="_blank" class="footer-gh-btn mt-3 d-inline-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            Yet-another-solution
          </a>
        </div>
        <div class="col-md-3">
          <h6 class="footer-section-title">{t('footer.navigation')}</h6>
          <ul class="list-unstyled footer-links">
            {navItems.map((item) => (
              <li><a href={localizePath(item.path, lang)}>{t(item.key)}</a></li>
            ))}
          </ul>
        </div>
        <div class="col-md-4">
          <h6 class="footer-section-title">{t('footer.team')}</h6>
          <div class="footer-team">
            <a href="https://github.com/MatejMa2ur" target="_blank" class="footer-team-member">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
              </svg>
              MatejMa2ur
            </a>
          </div>
        </div>
      </div>
      <hr class="footer-divider my-4" />
      <div class="row">
        <div class="col text-center">
          <p class="jet-brains-mono footer-copy">&copy; {new Date().getFullYear()} Y-A-S. {t('footer.builtWith')}</p>
        </div>
      </div>
    </div>
  </footer>

  <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
