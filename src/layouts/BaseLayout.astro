---
// Bootstrap and the fonts are bundled from npm rather than a CDN, so a page
// view sends the visitor's IP address to nobody but our own host. They must
// stay above global.css, whose rules override Bootstrap's. Only the latin and
// latin-ext subsets (Slovak needs latin-ext) of the weights the CSS uses.
import 'bootstrap/dist/css/bootstrap.min.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-ext-400.css';
import '@fontsource/jetbrains-mono/latin-400-italic.css';
import '@fontsource/jetbrains-mono/latin-ext-400-italic.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-ext-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '@fontsource/jetbrains-mono/latin-ext-600.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '@fontsource/jetbrains-mono/latin-ext-700.css';
import '@fontsource/rubik-mono-one/latin-400.css';
import '@fontsource/rubik-mono-one/latin-ext-400.css';
// The display face sets every page title (the LCP text), so it is preloaded.
import rubikLatin from '@fontsource/rubik-mono-one/files/rubik-mono-one-latin-400-normal.woff2?url';
import '../styles/global.css';
import { company } from '../company';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import {
  defaultLang,
  languages,
  localeTags,
  ogLocales,
  useTranslations,
  type Lang,
  type UIKey,
} from '../i18n/ui';
import { localizePath, switchLangPath } from '../i18n/routing';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isHome?: boolean;
  section?: string;
  lang?: Lang;
  /**
   * Per-language URLs for this exact page, feeding both the switcher and the
   * hreflang tags. Pages whose translated slug differs (blog posts, projects)
   * pass them explicitly; everything else defaults to a `/sk/` prefix swap.
   * A null entry means "not translated" — no alternate is advertised.
   */
  alternates?: Partial<Record<Lang, string | null>>;
  /** Keeps the page out of search results — the 404 page sets it. */
  noindex?: boolean;
  /** Marks the page as a blog post: `og:type` article, dates and BlogPosting JSON-LD. */
  article?: { published: Date; modified?: Date; author: string };
  /** Short page name for the breadcrumb trail; defaults to `title`. */
  pageName?: string;
  /** schema.org type of this page's WebPage node. */
  pageType?: 'WebPage' | 'ContactPage' | 'CollectionPage';
  /** Extra JSON-LD nodes for this page (a project, an item list), added to the graph. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = '/img/og-default.jpg',
  isHome = false,
  section = '',
  lang = defaultLang,
  alternates = {},
  noindex = false,
  article,
  pageName = title,
  pageType = 'WebPage',
  jsonLd: extraNodes = [],
} = Astro.props;

const t = useTranslations(lang);

const fullTitle = isHome ? t('site.title') : `${title} | Y-A-S`;
const pageDescription = description ?? t('site.description');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const langCodes = Object.keys(languages) as Lang[];

// Resolved once so the switcher and the hreflang tags can never disagree.
const alternateHrefs = Object.fromEntries(
  langCodes.map((code) => [
    code,
    alternates[code] === undefined ? switchLangPath(Astro.url.pathname, code) : alternates[code],
  ])
) as Record<Lang, string | null>;

const hreflangLinks = langCodes
  .filter((code) => alternateHrefs[code])
  .map((code) => ({
    hreflang: localeTags[code],
    href: new URL(alternateHrefs[code] as string, Astro.site).href,
  }));

const xDefault = alternateHrefs[defaultLang]
  ? new URL(alternateHrefs[defaultLang] as string, Astro.site).href
  : null;

// Structured data, as one @graph per page. The company and the site are
// described in full on the homepages; every other page points at them by @id.
const siteUrl = new URL('/', Astro.site).href;
const orgRef = { '@id': `${siteUrl}#organization` };
const websiteRef = { '@id': `${siteUrl}#website` };
const pageId = `${canonicalURL.href}#webpage`;
const logoUrl = new URL('/img/logo-200.png', Astro.site).href;

const organization = {
  '@type': 'Organization',
  ...orgRef,
  name: 'Y-A-S',
  alternateName: 'Yet Another Solution',
  legalName: company.name,
  url: siteUrl,
  logo: { '@type': 'ImageObject', url: logoUrl, width: 200, height: 200 },
  image: logoUrl,
  description: t('site.description'),
  email: company.email,
  taxID: company.cvr,
  identifier: { '@type': 'PropertyValue', propertyID: 'CVR', value: company.cvr },
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    postalCode: company.city.split(' ')[0],
    addressLocality: company.city.split(' ').slice(1).join(' '),
    addressCountry: 'DK',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: company.email,
    availableLanguage: ['en', 'sk'],
  },
  knowsAbout: ['C#', '.NET', 'Blazor', 'MapLibre', 'Hackathons'],
  makesOffer: (['schema.serviceWebApps', 'schema.serviceEvents'] as const).map((key) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: t(key), provider: orgRef },
  })),
  subOrganization: {
    '@type': 'Organization',
    '@id': 'https://cod3rs.org/#org',
    name: 'Cod3rs Community',
    url: 'https://cod3rs.org',
  },
  sameAs: [
    'https://github.com/Yet-another-solution',
    `https://datacvr.virk.dk/enhed/virksomhed/${company.cvr}`,
  ],
};

const website = {
  '@type': 'WebSite',
  ...websiteRef,
  url: siteUrl,
  name: 'Y-A-S',
  alternateName: 'Yet Another Solution',
  publisher: orgRef,
  inLanguage: langCodes.map((code) => localeTags[code]),
};

// Home > [section index] > this page. A section's own index page ends the
// trail at the section; the 404 and the homepage have none.
const sectionPath = section && section !== 'home' ? localizePath(`/${section}/`, lang) : null;
const breadcrumbItems = isHome || noindex
  ? []
  : [
      { name: t('nav.home'), path: localizePath('/', lang) },
      ...(sectionPath ? [{ name: t(`nav.${section}` as UIKey), path: sectionPath }] : []),
      ...(sectionPath === Astro.url.pathname ? [] : [{ name: pageName ?? '', path: Astro.url.pathname }]),
    ];
const breadcrumb = breadcrumbItems.length > 0 && {
  '@type': 'BreadcrumbList',
  '@id': `${canonicalURL.href}#breadcrumb`,
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: new URL(item.path, Astro.site).href,
  })),
};

const webPage = {
  '@type': pageType,
  '@id': pageId,
  url: canonicalURL.href,
  name: fullTitle,
  description: pageDescription,
  inLanguage: localeTags[lang],
  isPartOf: websiteRef,
  ...(isHome ? { about: orgRef } : {}),
  ...(breadcrumb ? { breadcrumb: { '@id': breadcrumb['@id'] } } : {}),
};

const blogPosting = article && {
  '@type': 'BlogPosting',
  headline: title,
  description: pageDescription,
  image: ogImage.href,
  datePublished: article.published.toISOString(),
  dateModified: (article.modified ?? article.published).toISOString(),
  inLanguage: localeTags[lang],
  mainEntityOfPage: { '@id': pageId },
  author: { '@type': 'Organization', name: article.author },
  publisher: { ...orgRef, name: 'Y-A-S' },
};

const jsonLd = noindex
  ? null
  : {
      '@context': 'https://schema.org',
      '@graph': [
        ...(isHome ? [organization, website] : []),
        webPage,
        ...(breadcrumb ? [breadcrumb] : []),
        ...(blogPosting ? [blogPosting] : []),
        ...extraNodes,
      ],
    };

const navItems = [
  { key: 'nav.home', path: '/', section: 'home' },
  { key: 'nav.blog', path: '/blog/', section: 'blog' },
  { key: 'nav.projects', path: '/projects/', section: 'projects' },
  { key: 'nav.contact', path: '/contact/', section: 'contact' },
] as const;
---

<!DOCTYPE html>
<html lang={localeTags[lang]}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta name="description" content={pageDescription} />
  <meta name="author" content="Y-A-S Team" />
  <meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />
  <link rel="canonical" href={canonicalURL} />

  {hreflangLinks.map(({ hreflang, href }) => (
    <link rel="alternate" hreflang={hreflang} href={href} />
  ))}
  {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

  <meta property="og:type" content={article ? 'article' : 'website'} />
  {article && <meta property="article:published_time" content={article.published.toISOString()} />}
  {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={ogLocales[lang]} />
  {langCodes
    .filter((code) => code !== lang && alternateHrefs[code])
    .map((code) => <meta property="og:locale:alternate" content={ogLocales[code]} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preload" href={rubikLatin} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{fullTitle}</title>

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  )}

  <slot name="head" />
</head>
<body>
  {isHome ? (
    <LanguageSwitcher lang={lang} hrefs={alternateHrefs} variant="floating" />
  ) : (
    <nav class="navbar navbar-expand-lg navbar-dark yas-navbar">
      <div class="yas-container yas-navbar-inner">
        <a class="yas-navbar-brand rubik" href={localizePath('/', lang)} aria-label={t('nav.homeAria')}>Y-A-S</a>
        <div class="d-flex align-items-center gap-2 ms-auto order-lg-3">
          <LanguageSwitcher lang={lang} hrefs={alternateHrefs} />
          <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label={t('nav.toggle')}>
            <span class="navbar-toggler-icon"></span>
          </button>
        </div>
        <div class="collapse navbar-collapse order-lg-2" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            {navItems.map((item) => (
              <li class="nav-item">
                <a
                  class={`nav-link yas-nav-link${section === item.section ? ' yas-nav-active' : ''}`}
                  href={localizePath(item.path, lang)}
                  aria-current={section === item.section ? 'page' : undefined}
                >
                  {t(item.key)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </nav>
  )}

  <slot />

  <footer class="yas-footer">
    <div class="yas-container">
      <div class="footer-top">
        <div class="footer-brand">
          <span class="rubik footer-logo">Y-A-S</span>
          <p class="footer-description">{t('site.description')}</p>
          <a href="https://github.com/Yet-another-solution" target="_blank" rel="noopener" class="footer-gh">
            Yet-another-solution
          </a>
        </div>
        <div>
          <p class="footer-section-title">{t('footer.navigation')}</p>
          <ul class="list-unstyled footer-links">
            {navItems.map((item) => (
              <li><a href={localizePath(item.path, lang)}>{t(item.key)}</a></li>
            ))}
            <li><a href={localizePath('/privacy/', lang)}>{t('footer.privacy')}</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-section-title">{t('footer.network')}</p>
          <ul class="list-unstyled footer-links">
            <li><a href="https://cod3rs.org/" target="_blank" rel="noopener">Cod3rs</a> <span class="footer-link-note">{t('footer.cod3rs')}</span></li>
            <li><a href="https://hackesbjerg.dk/" target="_blank" rel="noopener">Hack Esbjerg</a> <span class="footer-link-note">{t('footer.hackEsbjerg')}</span></li>
          </ul>
        </div>
        <div>
          <p class="footer-section-title">{t('footer.team')}</p>
          <ul class="list-unstyled footer-links">
            <li><a href="https://github.com/MatejMa2ur" target="_blank" rel="noopener">MatejMa2ur</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="footer-legal">
          &copy; {new Date().getFullYear()} {company.name} &middot; {t('company.cvr')} {company.cvr} &middot;
          {company.street}, {company.city}, {t('company.country')} &middot;
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </p>
        <p class="footer-built">{t('footer.builtWith')}</p>
      </div>
    </div>
  </footer>

  <script>
    // Only the navbar toggler needs Bootstrap's JS.
    import 'bootstrap/js/dist/collapse';
  </script>
</body>
</html>
