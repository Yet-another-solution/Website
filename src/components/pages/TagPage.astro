---
/** Posts carrying one tag, shared by `/tags/[tag]/` and `/sk/tags/[tag]/`. */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Backdrop from '../Backdrop.astro';
import PageHero from '../PageHero.astro';
import BlogFilters from '../BlogFilters.astro';
import PostCard from '../PostCard.astro';
import { defaultLang, pluralPosts, useTranslations, type Lang } from '../../i18n/ui';
import { getLocalizedCollection } from '../../i18n/content';

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
  lang?: Lang;
  alternates?: Partial<Record<Lang, string | null>>;
}

const { tag, posts, lang = defaultLang, alternates } = Astro.props;
const t = useTranslations(lang);
const sorted = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// The filter bar lists every tag and series in this language, not just this tag's.
const allPosts = await getLocalizedCollection('blog', lang);
---

<BaseLayout
  title={`${t('blog.tagPrefix')} ${tag}`}
  description={`${t('blog.taggedWith')} ${tag}`}
  section="blog"
  lang={lang}
  alternates={alternates}
>
  <main class="yas-page">
    <Backdrop variant="grid" />
    <PageHero
      label={t('blog.tagLabel')}
      title={tag}
      subtitle={`${sorted.length} ${pluralPosts(lang, sorted.length)}`}
    />
    <div class="yas-container page-content">
      <BlogFilters allPosts={allPosts} activeTag={tag} lang={lang} />
      <div class="post-grid">
        {sorted.map((post) => <PostCard post={post} lang={lang} />)}
      </div>
    </div>
  </main>
</BaseLayout>
