---
/** A single project, shared by `/projects/[slug]/` and `/sk/projects/[slug]/`. */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Backdrop from '../Backdrop.astro';
import PageHero from '../PageHero.astro';
import { defaultLang, formatDate, useTranslations, type Lang } from '../../i18n/ui';
import { localizePath } from '../../i18n/routing';

interface Props {
  project: CollectionEntry<'projects'>;
  lang?: Lang;
  alternates?: Partial<Record<Lang, string | null>>;
}

const { project, lang = defaultLang, alternates } = Astro.props;
const t = useTranslations(lang);
const { Content } = await project.render();
const techs = project.data.tech?.split(',').map(tech => tech.trim()).filter(Boolean) ?? [];
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  image={project.data.image}
  section="projects"
  lang={lang}
  alternates={alternates}
>
  <main class="yas-page">
    <Backdrop variant="squares" />
    <PageHero
      label={techs.join(' · ') || t('projects.title')}
      title={project.data.title}
      subtitle={project.data.description}
    />
    <div class="yas-container page-content">
      <a href={localizePath('/projects/', lang)} class="text-link">{t('projects.back')}</a>
      <div class="split">
        <div class="split-main">
          {project.data.image && (
            <img src={project.data.image} alt={project.data.title} class="project-image" loading="lazy" />
          )}
          <div class="prose">
            <Content />
          </div>
        </div>

        <aside class="dark-card split-side">
          <p class="eyebrow eyebrow--green">{t('projects.details')}</p>

          {techs.length > 0 && (
            <div>
              <p class="eyebrow eyebrow--dim">{t('projects.technologies')}</p>
              <ul class="tech-list">
                {techs.map((tech) => <li class="chip chip--ghost">{tech}</li>)}
              </ul>
            </div>
          )}

          <div>
            <p class="eyebrow eyebrow--dim">{t('projects.date')}</p>
            <p class="dark-card-value">{formatDate(project.data.date, lang)}</p>
          </div>

          {project.data.webUrl && (
            <a href={project.data.webUrl} target="_blank" rel="noopener" class="btn-yas btn-yas--green">
              {t('projects.visitPage')}
            </a>
          )}
          {project.data.github && (
            <a href={project.data.github} target="_blank" rel="noopener" class="btn-yas btn-yas--ghost">
              {t('projects.githubRepo')}
            </a>
          )}
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>
