---
/** A single blog post, shared by `/blog/[slug]/` and `/sk/blog/[slug]/`. */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugify } from '../../utils/slugify';
import {
  defaultLang,
  formatDate,
  pluralPosts,
  useTranslations,
  type Lang,
} from '../../i18n/ui';
import { localizePath } from '../../i18n/routing';
import { entrySlug, getLocalizedCollection } from '../../i18n/content';

interface Props {
  post: CollectionEntry<'blog'>;
  lang?: Lang;
  alternates?: Partial<Record<Lang, string | null>>;
}

const { post, lang = defaultLang, alternates } = Astro.props;
const t = useTranslations(lang);
const { Content } = await post.render();

// Series navigation only ever spans posts in the same language.
const sameLangPosts = await getLocalizedCollection('blog', lang);
let seriesPosts: typeof sameLangPosts = [];
let currentIndex = -1;
if (post.data.series && post.data.series.length > 0) {
  const seriesName = post.data.series[0];
  seriesPosts = sameLangPosts
    .filter(p => p.data.series?.includes(seriesName))
    .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
  currentIndex = seriesPosts.findIndex(p => p.slug === post.slug);
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.images?.[0]}
  section="blog"
  lang={lang}
  alternates={alternates}
>
  <div class="yas-page-canvas">
    <div class="yas-panel">
      <div class="yas-panel-inner">
        <article class="blog-post">

          <nav class="blog-nav-back">
            <a href={localizePath('/blog/', lang)} class="back-to-blog">
              <span class="back-icon">←</span>
              <span class="back-text">{t('blog.backToBlog')}</span>
            </a>
          </nav>

          <header class="post-header">
            <div class="post-meta-enhanced">
              <h1>{post.data.title}</h1>
              <div class="meta-secondary">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                  <div>
                    <span class="meta-label">{t('blog.published')}</span>
                    <time datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date, lang)}
                    </time>
                    {post.data.author && (
                      <div class="meta-content mt-1">
                        <span class="meta-label">{t('blog.author')}</span>
                        <span>{t('blog.by')} {post.data.author}</span>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>

            {post.data.series && post.data.series.length > 0 && (
              <div class="post-series-info">
                {post.data.series.map(s => (
                  <div class="series-banner">
                    <span class="series-icon">📚</span>
                    <span class="series-text">
                      {t('blog.seriesPartBefore', { order: post.data.seriesOrder ?? 1 })}{' '}
                      <a href={localizePath(`/series/${slugify(s)}/`, lang)}>{s}</a>{' '}
                      {t('blog.seriesPartAfter')}
                      {' '}({seriesPosts.length} {pluralPosts(lang, seriesPosts.length)})
                    </span>
                  </div>
                ))}
              </div>
            )}

            {post.data.images && post.data.images.length > 0 && (
              <div class="featured-image">
                <img src={post.data.images[0]} alt={post.data.title} loading="lazy" />
              </div>
            )}
          </header>

          <div class="post-content">
            <Content />
          </div>

          <footer class="post-footer" style="display: block;">
            {(post.data.tags || post.data.series) && (
              <div class="post-taxonomies">
                {post.data.tags && (
                  <div class="post-tags">
                    <h4>{t('blog.tags')}</h4>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                      {post.data.tags.map(tag => (
                        <a href={localizePath(`/tags/${slugify(tag)}/`, lang)} class="tag">{tag}</a>
                      ))}
                    </div>
                  </div>
                )}
                {post.data.series && (
                  <div class="post-series mt-3">
                    <h4>{t('blog.series')}</h4>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                      {post.data.series.map(s => (
                        <a href={localizePath(`/series/${slugify(s)}/`, lang)} class="series">{s}</a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            )}

            {seriesPosts.length > 1 && (
              <nav class="series-navigation mt-4">
                <h4>{post.data.series?.[0]} — {t('blog.seriesNav')}</h4>
                <div class="series-nav-links">
                  {currentIndex > 0 && (
                    <a href={localizePath(`/blog/${entrySlug(seriesPosts[currentIndex - 1])}/`, lang)} class="series-prev">
                      ← {seriesPosts[currentIndex - 1].data.title}
                    </a>
                  )}
                  {currentIndex < seriesPosts.length - 1 && (
                    <a href={localizePath(`/blog/${entrySlug(seriesPosts[currentIndex + 1])}/`, lang)} class="series-next">
                      {seriesPosts[currentIndex + 1].data.title} →
                    </a>
                  )}
                </div>
                <div class="series-progress">
                  <span>{t('blog.progress')} {currentIndex + 1}/{seriesPosts.length}</span>
                </div>
              </nav>
            )}
          </footer>

        </article>
      </div>
    </div>
  </div>
</BaseLayout>
