---
/** A single blog post, shared by `/blog/[slug]/` and `/sk/blog/[slug]/`. */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Backdrop from '../Backdrop.astro';
import PageHero from '../PageHero.astro';
import { slugify } from '../../utils/slugify';
import {
  defaultLang,
  formatDate,
  pluralPosts,
  useTranslations,
  type Lang,
} from '../../i18n/ui';
import { localizePath } from '../../i18n/routing';
import { entrySlug, getLocalizedCollection } from '../../i18n/content';

interface Props {
  post: CollectionEntry<'blog'>;
  lang?: Lang;
  alternates?: Partial<Record<Lang, string | null>>;
}

const { post, lang = defaultLang, alternates } = Astro.props;
const t = useTranslations(lang);
const { Content } = await post.render();

// Series navigation only ever spans posts in the same language.
const sameLangPosts = await getLocalizedCollection('blog', lang);
const seriesName = post.data.series?.[0];
let seriesPosts: typeof sameLangPosts = [];
let currentIndex = -1;
if (seriesName) {
  seriesPosts = sameLangPosts
    .filter(p => p.data.series?.includes(seriesName))
    .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
  currentIndex = seriesPosts.findIndex(p => p.slug === post.slug);
}
const otherSeries = post.data.series?.slice(1) ?? [];
const prevPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : undefined;
const nextPost = currentIndex >= 0 ? seriesPosts[currentIndex + 1] : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.images?.[0]}
  section="blog"
  lang={lang}
  alternates={alternates}
>
  <main class="yas-page">
    <Backdrop variant="lines" />
    <article>
      <PageHero
        compact
        label={
          seriesName
            ? `${t('blog.seriesPartBefore', { order: post.data.seriesOrder ?? 1 })} ${seriesName} ${t('blog.seriesPartAfter')}`
            : t('blog.title')
        }
        title={post.data.title}
      >
        <a slot="before" href={localizePath('/blog/', lang)} class="text-link">← {t('blog.backToBlog')}</a>
        <div class="post-meta-row">
          <span class="chip chip--label">{t('blog.published')}</span>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
          {post.data.author && <span>{t('blog.by')} {post.data.author}</span>}
        </div>
        {(post.data.tags?.length || otherSeries.length > 0) && (
          <div class="chip-row">
            {post.data.tags?.map((tag) => (
              <a href={localizePath(`/tags/${slugify(tag)}/`, lang)} class="pill">{tag}</a>
            ))}
            {/* The side card covers the first series; any others are linked here. */}
            {otherSeries.map((s) => (
              <a href={localizePath(`/series/${slugify(s)}/`, lang)} class="pill">{s}</a>
            ))}
          </div>
        )}
      </PageHero>

      <div class="yas-container page-content page-content--post">
        <div class="split">
          <div class="split-main">
            {post.data.images && post.data.images.length > 0 && (
              <img src={post.data.images[0]} alt={post.data.title} class="project-image" loading="lazy" />
            )}
            <div class="prose">
              <Content />
            </div>
            {(prevPost || nextPost) && (
              <nav class="series-nav" aria-label={seriesName}>
                {prevPost && (
                  <a href={localizePath(`/blog/${entrySlug(prevPost)}/`, lang)} class="text-link">← {prevPost.data.title}</a>
                )}
                {nextPost && (
                  <a href={localizePath(`/blog/${entrySlug(nextPost)}/`, lang)} class="text-link series-nav-next">{nextPost.data.title} →</a>
                )}
              </nav>
            )}
          </div>

          {seriesName && (
            <aside class="light-card split-side">
              <p class="eyebrow eyebrow--muted">{t('blog.seriesLabel')}</p>
              <h2 class="series-card-title">
                <a href={localizePath(`/series/${slugify(seriesName)}/`, lang)}>{seriesName}</a>
              </h2>
              <p class="post-card-meta">{seriesPosts.length} {pluralPosts(lang, seriesPosts.length)}</p>
              <ol class="series-card-list">
                {seriesPosts.map((p, i) => (
                  <li>
                    <span class="series-card-number">{String(i + 1).padStart(2, '0')}</span>
                    {i === currentIndex ? (
                      <span aria-current="page">{p.data.title}</span>
                    ) : (
                      <a href={localizePath(`/blog/${entrySlug(p)}/`, lang)}>{p.data.title}</a>
                    )}
                  </li>
                ))}
              </ol>
            </aside>
          )}
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
