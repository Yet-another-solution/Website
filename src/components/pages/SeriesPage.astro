---
/** One series' posts in order, shared by `/series/[series]/` and `/sk/series/[series]/`. */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Backdrop from '../Backdrop.astro';
import PageHero from '../PageHero.astro';
import {
  defaultLang,
  formatDate,
  pluralPosts,
  useTranslations,
  type Lang,
} from '../../i18n/ui';
import { localizePath } from '../../i18n/routing';
import { entrySlug } from '../../i18n/content';

interface Props {
  seriesName: string;
  posts: CollectionEntry<'blog'>[];
  lang?: Lang;
  alternates?: Partial<Record<Lang, string | null>>;
}

const { seriesName, posts, lang = defaultLang, alternates } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  title={seriesName}
  description={t('blog.seriesAllPosts', { series: seriesName })}
  section="blog"
  lang={lang}
  alternates={alternates}
>
  <main class="yas-page">
    <Backdrop variant="grid" />
    <PageHero
      label={t('blog.seriesLabel')}
      title={seriesName}
      subtitle={`${posts.length} ${pluralPosts(lang, posts.length)}`}
    />
    <div class="yas-container page-content">
      <ol class="series-list">
        {posts.map((post, i) => {
          const href = localizePath(`/blog/${entrySlug(post)}/`, lang);
          return (
            <li class="series-item">
              <span class="series-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="series-item-body">
                <h2 class="series-item-title"><a href={href}>{post.data.title}</a></h2>
                <p class="post-card-meta">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
                  {post.data.author && <span> · {t('blog.by')} {post.data.author}</span>}
                </p>
                {post.data.description && <p class="series-item-desc">{post.data.description}</p>}
                <a href={href} class="text-link" aria-hidden="true" tabindex="-1">{t('blog.readMore')}</a>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </main>
</BaseLayout>
