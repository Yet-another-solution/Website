---
/** The projects listing, shared by `/projects/` and `/sk/projects/`. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Backdrop from '../Backdrop.astro';
import PageHero from '../PageHero.astro';
import ProjectCard from '../ProjectCard.astro';
import { defaultLang, useTranslations, type Lang } from '../../i18n/ui';
import { getLocalizedCollection } from '../../i18n/content';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getLocalizedCollection('projects', lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title={t('projects.title')}
  description={t('projects.description')}
  section="projects"
  lang={lang}
>
  <main class="yas-page">
    <Backdrop variant="diamonds" />
    <PageHero label={t('projects.title')} title={t('projects.title')} subtitle={t('home.work.body')} />
    <div class="yas-container page-content">
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} lang={lang} heading="h2" />)}
      </div>
    </div>
  </main>
</BaseLayout>
