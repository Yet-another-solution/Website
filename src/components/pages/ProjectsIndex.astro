---
/** The projects listing, shared by `/projects/` and `/sk/projects/`. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Backdrop from '../Backdrop.astro';
import PageHero from '../PageHero.astro';
import ProjectCard from '../ProjectCard.astro';
import { defaultLang, useTranslations, type Lang } from '../../i18n/ui';
import { entrySlug, getLocalizedCollection } from '../../i18n/content';
import { localizePath } from '../../i18n/routing';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getLocalizedCollection('projects', lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const itemList = {
  '@type': 'ItemList',
  itemListElement: projects.map((project, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: project.data.title,
    url: new URL(localizePath(`/projects/${entrySlug(project)}/`, lang), Astro.site).href,
  })),
};
---

<BaseLayout
  title={t('projects.metaTitle')}
  description={t('projects.description')}
  section="projects"
  pageType="CollectionPage"
  jsonLd={[itemList]}
  lang={lang}
>
  <main class="yas-page">
    <Backdrop variant="diamonds" />
    <PageHero label={t('projects.title')} title={t('projects.title')} subtitle={t('projects.intro')} />
    <div class="yas-container page-content">
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} lang={lang} heading="h2" />)}
      </div>
    </div>
  </main>
</BaseLayout>
