---
/**
 * The blog listing, shared by `/blog/` and `/sk/blog/`. Each language lists only
 * its own posts — a Slovak reader never lands on an English summary.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Backdrop from '../Backdrop.astro';
import PageHero from '../PageHero.astro';
import BlogFilters from '../BlogFilters.astro';
import PostCard from '../PostCard.astro';
import { defaultLang, useTranslations, type Lang } from '../../i18n/ui';
import { getLocalizedCollection } from '../../i18n/content';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getLocalizedCollection('blog', lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title={t('blog.title')} description={t('blog.description')} section="blog" lang={lang}>
  <main class="yas-page">
    <Backdrop variant="rings" />
    <PageHero label={t('blog.title')} title={t('blog.title')} subtitle={t('home.blog.body')} />
    <div class="yas-container page-content">
      <BlogFilters allPosts={posts} lang={lang} />
      <div class="post-grid">
        {posts.map((post) => <PostCard post={post} lang={lang} />)}
      </div>
      {posts.length === 0 && <p class="muted">{t('blog.empty')}</p>}
    </div>
  </main>
</BaseLayout>
