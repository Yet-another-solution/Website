---
/**
 * The homepage, shared by `/` (English) and `/sk/` (Slovak). Only the strings
 * and the internal links differ between the two, so the markup — and the hero's
 * WebGL choreography, which keys off section document order — lives here once.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Backdrop from '../Backdrop.astro';
import SectionScene from '../SectionScene.astro';
import PostCard from '../PostCard.astro';
import ProjectCard from '../ProjectCard.astro';
import { defaultLang, useTranslations, type Lang } from '../../i18n/ui';
import { localizePath } from '../../i18n/routing';
import { getLocalizedCollection } from '../../i18n/content';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

// The three most recent projects headline the Selected Work band.
const featuredProjects = (await getLocalizedCollection('projects', lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// The most recent post sits beside the blog band's diagram.
const latestPosts = (await getLocalizedCollection('blog', lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 1);

const steps = ['discovery', 'build', 'review', 'ship'] as const;
---

<BaseLayout isHome={true} lang={lang}>
  <!-- Hero -->
  <div class="w-100 dark d-flex" id="home">
    <div class="dark-bg w-100 h-100 hero-inner">
      <div class="white-square">
        <div class="lr-ws"></div>
        <div class="lr-ws-center">
          <div class="lr-ws d-flex flex-column" id="hero-frame" style="height:100%">
            <div class="s-text">
              <p class="rubik display-1 h1 dark-text text-center hero-wordmark" aria-hidden="true">Y-A-S</p>
            </div>
            <div class="d-flex h-100">
              <div class="col-2 d-flex justify-content-start align-items-end">
                <img src="/img/Squares.svg" alt="" width="178" height="500" class="img-fluid" id="squares-fallback" style="max-height: 100%; object-fit: contain;" />
              </div>
              <div class="col-8 d-flex justify-content-center align-items-start">
                <div>
                  <div class="d-flex flex-column justify-content-center align-items-center mb-2">
                    <hr class="w-50" style="border-color: #333C4D" />
                  </div>
                  <div class="jet-brains-mono dark-text hero-tagline" aria-hidden="true">
                    Solution <br />
                    Another <br />
                    Yet
                  </div>
                </div>
              </div>
              <div class="col-2 d-flex flex-column justify-content-end align-items-center pb-3">
                <div class="dark-bg rounded-pill p-2 d-none d-sm-flex flex-column gap-4 align-items-center" style="box-shadow: inset 2px 2px 4px rgba(0,0,0,0.3), inset -2px -2px 4px rgba(255,255,255,0.1); width: 60px;">
                  <a href="https://github.com/Yet-another-solution" target="_blank" rel="noopener" aria-label={t('home.hero.githubTitle')} title={t('home.hero.githubTitle')} class="btn btn-light rounded-circle p-2" style="width: 40px; height: 40px; display: flex; justify-content: center; align-items: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                    </svg>
                  </a>
                  <div class="d-flex flex-column" style="width: 45px; height: 135px;">
                    <a href={localizePath('/projects/', lang)} title={t('home.hero.projectsTitle')} aria-label={t('home.hero.projectsTitle')} class="btn btn-light d-flex justify-content-center align-items-center" style="flex: 1; border-radius: 25px 25px 0 0; border-bottom: 1px solid #333C4D;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h4.672a2 2 0 0 1 2 2l-.04.87a1.99 1.99 0 0 0-.342-.87A1 1 0 0 0 15.172 4H9.828a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 6.172 2H2.5a1 1 0 0 0-1 1l.04.87a1.99 1.99 0 0 0-.342.87z"/>
                        <path d="M2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H2zm0 1h12a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/>
                      </svg>
                    </a>
                    <a href={localizePath('/blog/', lang)} title={t('home.hero.blogTitle')} aria-label={t('home.hero.blogTitle')} class="btn btn-light d-flex justify-content-center align-items-center" style="flex: 1; border-radius: 0; border-bottom: 1px solid #333C4D; border-top: 1px solid #333C4D;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
                        <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2z"/>
                        <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1z"/>
                      </svg>
                    </a>
                    <a href="#what" title={t('home.hero.scrollTitle')} aria-label={t('home.hero.scrollTitle')} class="btn btn-light d-flex justify-content-center align-items-center" style="flex: 1; border-radius: 0 0 25px 25px; border-top: 1px solid #333C4D;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="lr-ws"></div>
      </div>
      <!-- Who we are and the primary call to action, in the first viewport:
           beside the square on desktop, under it on phones and tablets. -->
      <div class="hero-panel">
        <p class="eyebrow eyebrow--green">{t('home.intro.label')}</p>
        <h1 class="hero-title">{t('home.hero.title')}</h1>
        <p class="hero-lead">{t('home.hero.lead')}</p>
        <div class="btn-row">
          <a href={localizePath('/contact/', lang)} class="btn-yas btn-yas--green">{t('home.hero.cta')}</a>
          <a href={localizePath('/projects/', lang)} class="btn-yas btn-yas--ghost">{t('home.intro.viewProjects')}</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Transition line -->
  <div id="start"></div>

  <!-- The five bands below. The hero script pairs each of its squares with a
       `.reveal-section` by document order and reads the band's `.eyebrow` for
       the square's tooltip, so the order, the count and those two class names
       are load-bearing. -->
  <main id="what">
    <section class="home-band reveal-section">
      <Backdrop variant="rings" />
      <div class="yas-container home-band-inner">
        <div class="accent-bar"></div>
        <p class="eyebrow">{t('home.intro.label')}</p>
        <h2 class="home-heading home-heading--xl">{t('home.intro.heading')}<span class="accent-dot">.</span></h2>
        <p class="lead-text">{t('home.intro.body')}</p>
        <ul class="chip-row list-unstyled">
          {['C#', '.NET', 'Blazor', 'MapLibre'].map((tech) => <li class="pill pill--static">{tech}</li>)}
        </ul>
        <div class="btn-row">
          <a href={localizePath('/contact/', lang)} class="btn-yas btn-yas--navy">{t('home.intro.contactUs')}</a>
          <a href={localizePath('/projects/', lang)} class="btn-yas btn-yas--outline">{t('home.intro.viewProjects')}</a>
        </div>
      </div>
    </section>

    <section class="home-band home-band--alt home-band--mirror reveal-section">
      <Backdrop variant="arcs" />
      <div class="yas-container home-band-inner">
        <div class="home-split">
          <div class="home-split-text">
            <div class="accent-bar"></div>
            <p class="eyebrow">{t('home.why.label')}</p>
            <h2 class="home-heading">{t('home.why.heading')}</h2>
            <p class="lead-text">{t('home.why.body')}</p>
          </div>
          <div class="home-split-scene"><SectionScene name="ownership" lang={lang} /></div>
        </div>
      </div>
    </section>

    <section class="home-band reveal-section">
      <Backdrop variant="grid" />
      <div class="yas-container home-band-inner">
        <div class="home-split">
          <div class="home-split-text">
            <div class="accent-bar"></div>
            <p class="eyebrow">{t('home.how.label')}</p>
            <h2 class="home-heading">{t('home.how.heading')}</h2>
            <p class="lead-text">{t('home.how.body')}</p>
          </div>
          <div class="home-split-scene"><SectionScene name="workflow" lang={lang} /></div>
        </div>
        <ol class="step-grid list-unstyled">
          {steps.map((step, i) => (
            <li class="step-card">
              <span class="step-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="step-title">{t(`home.how.${step}` as const)}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="home-band home-band--alt reveal-section">
      <Backdrop variant="diamonds" />
      <div class="yas-container home-band-inner">
        <div class="accent-bar"></div>
        <p class="eyebrow">{t('home.work.label')}</p>
        <h2 class="home-heading">{t('home.work.heading')}</h2>
        <p class="lead-text">{t('home.work.body')}</p>
        <div class="project-grid">
          {featuredProjects.map((project) => <ProjectCard project={project} lang={lang} />)}
        </div>
        <div class="btn-row">
          <a href={localizePath('/projects/', lang)} class="btn-yas btn-yas--outline">{t('home.work.viewAll')}</a>
        </div>
      </div>
    </section>

    <section class="home-band reveal-section">
      <Backdrop variant="lines" />
      <div class="yas-container home-band-inner">
        <div class="accent-bar"></div>
        <p class="eyebrow">{t('home.blog.label')}</p>
        <h2 class="home-heading">{t('home.blog.heading')}</h2>
        <p class="lead-text">{t('home.blog.body')}</p>
        <div class="home-split">
          <div class="home-split-text">
            {latestPosts.map((post) => <PostCard post={post} lang={lang} heading="h3" />)}
          </div>
          <div class="home-split-scene"><SectionScene name="blog" lang={lang} /></div>
        </div>
        <div class="btn-row">
          <a href={localizePath('/blog/', lang)} class="btn-yas btn-yas--navy">{t('home.blog.explore')}</a>
        </div>
      </div>
    </section>

    <!-- Not a `.reveal-section`: the hero squares pair with the five bands above. -->
    <section class="home-closing">
      <div class="yas-container home-closing-inner">
        <h2 class="home-heading">{t('home.cta.heading')}</h2>
        <p class="lead-text">{t('home.cta.body')}</p>
        <div class="btn-row">
          <a href={localizePath('/contact/', lang)} class="btn-yas btn-yas--green">{t('home.hero.cta')}</a>
        </div>
      </div>
    </section>
  </main>

  <script>
    // Full-screen bands: the one crossing the middle of the viewport is the
    // active one. Its text fades in, its diagram draws itself, and its
    // backdrop cross-fades with the previous band's (see "HOMEPAGE BANDS" in global.css). The styles only
    // hide anything once `home-anim` is set, so without JS, or with reduced
    // motion, every band is simply visible.
    const bands = document.querySelectorAll('.home-band');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('home-anim');
      const observer = new IntersectionObserver(
        (entries) => entries.forEach((entry) => entry.target.classList.toggle('is-active', entry.isIntersecting)),
        { rootMargin: '-45% 0px -45% 0px' }
      );
      bands.forEach((band) => observer.observe(band));
    }
  </script>

  <script>
    // The hero animation pulls in three.js, so it loads once the browser is
    // idle instead of competing with the first paint.
    const fallbackImg = document.getElementById('squares-fallback');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (fallbackImg && !reduceMotion) {
      const start = () =>
        import('../../scripts/heroSquares')
          .then(({ initHeroSquares }) => initHeroSquares(fallbackImg))
          .catch((err) => console.warn('Hero squares animation unavailable:', err));
      if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1000 });
      else setTimeout(start, 200);
    }
  </script>
</BaseLayout>
