---
/** The contact page, shared by `/contact/` and `/sk/contact/`. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Backdrop from '../Backdrop.astro';
import PageHero from '../PageHero.astro';
import { company } from '../../company';
import { defaultLang, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  title={t('contact.title')}
  description={t('contact.description')}
  section="contact"
  lang={lang}
>
  <main class="yas-page">
    <Backdrop variant="arcs" />
    <PageHero label={t('contact.title')} title={t('contact.heading')} subtitle={t('contact.body')} />
    <div class="yas-container page-content">
      <div class="split">
        <div class="split-main contact-links">
          <div>
            <p class="eyebrow eyebrow--muted">{t('contact.email')}</p>
            <a href={`mailto:${company.email}`} class="contact-value">{company.email}</a>
          </div>
          <div>
            <p class="eyebrow eyebrow--muted">{t('contact.github')}</p>
            <a href="https://github.com/Yet-another-solution" target="_blank" rel="noopener" class="contact-value">
              Yet-another-solution
            </a>
          </div>
          <p class="lead-text">{t('contact.closing')}</p>
        </div>

        <aside class="dark-card split-side split-side--wide">
          <p class="eyebrow eyebrow--green">{t('contact.company')}</p>
          <address class="company-card">
            <span class="company-card-name">{company.name}</span>
            <span>{t('company.cvr')} {company.cvr}</span>
            <span>{company.street}</span>
            <span>{company.city}, {t('company.country')}</span>
          </address>
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>
