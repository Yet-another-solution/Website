---
/** The privacy policy, shared by `/privacy/` and `/sk/privacy/`. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Backdrop from '../Backdrop.astro';
import PageHero from '../PageHero.astro';
import { company } from '../../company';
import { defaultLang, formatDate, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

// Bump this whenever the policy text in src/i18n/ui.ts changes.
// Built from parts, not an ISO string, so it is local midnight and the build
// machine's timezone cannot shift the printed day.
const lastUpdated = new Date(2026, 9, 8);

const sections = ['collect', 'not', 'why', 'recipients', 'transfers', 'retention'] as const;
---

<BaseLayout
  title={t('privacy.title')}
  description={t('privacy.description')}
  lang={lang}
>
  <main class="yas-page">
    <Backdrop variant="lines" />
    <PageHero
      label={t('privacy.label')}
      title={t('privacy.title')}
      subtitle={`${t('privacy.updated')} ${formatDate(lastUpdated, lang)}`}
    />
    <div class="yas-container page-content">
      <div class="prose">
        <p>{t('privacy.who.body')}</p>
        <address class="light-card">
          {company.name}<br />
          {t('company.cvr')} {company.cvr}<br />
          {company.street}<br />
          {company.city}, {t('company.country')}<br />
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </address>

        {sections.map((section) => (
          <>
            <h2>{t(`privacy.${section}.heading` as const)}</h2>
            <p>{t(`privacy.${section}.body` as const)}</p>
          </>
        ))}

        <h2>{t('privacy.rights.heading')}</h2>
        <p>
          {t('privacy.rights.body')}{' '}
          <a href={`mailto:${company.email}`}>{company.email}</a>.
        </p>

        <h2>{t('privacy.complaints.heading')}</h2>
        <p>
          {t('privacy.complaints.body')}{' '}
          <a href="https://www.datatilsynet.dk" target="_blank" rel="noopener">datatilsynet.dk</a>.
        </p>
      </div>
    </div>
  </main>
</BaseLayout>
