---
/**
 * One project card, as shown on /projects/ and in the homepage's Selected Work
 * band. Sharp corners with a left accent border on hover, matching the
 * post-preview and project-details-panel treatment used elsewhere on the site.
 *
 * The image is a backdrop layer behind the text rather than a fixed-height
 * block above it: the card keeps a minimum height but grows with its content,
 * so long titles and tech lists can never spill outside the tile. The tinted
 * gradient sits on the card itself, so a missing or broken image still leaves
 * a dark, readable surface.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const techs = project.data.tech?.split(',').map((t) => t.trim()).filter(Boolean) ?? [];
---

<article class="card project-card h-100 overflow-hidden">
  {project.data.image && (
    <img
      src={project.data.image}
      alt=""
      class="project-image"
      loading="lazy"
      onerror="this.classList.add('is-broken')"
    />
  )}
  <div class="project-tint"></div>
  <div class="project-content">
    <h3 class="h5 fw-bold text-white mb-2">{project.data.title}</h3>
    {techs.length > 0 && (
      <div class="d-flex flex-wrap gap-1 mb-2">
        {techs.map((tech) => (
          <span class="project-tech-badge">{tech}</span>
        ))}
      </div>
    )}
    {project.data.description && (
      <p class="text-white-50 small d-none d-md-block project-description">
        {project.data.description}
      </p>
    )}
    <div class="d-flex flex-wrap gap-2 mt-2">
      <a href={`/projects/${project.slug}/`} class="btn btn-sm project-btn-primary d-inline-flex align-items-center learn-more-btn">
        Learn More
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="ms-1" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
        </svg>
      </a>
      {project.data.webUrl && (
        <a href={project.data.webUrl} class="btn btn-sm project-btn-ghost d-inline-flex align-items-center learn-more-btn">
          Visit Page
        </a>
      )}
      {project.data.github && (
        <a href={project.data.github} class="btn btn-sm project-btn-ghost d-inline-flex align-items-center learn-more-btn">
          GitHub
        </a>
      )}
    </div>
  </div>
</article>

<style>
/* Sharp corners + left-accent-border on hover instead of Bootstrap's default
   rounded-card-with-shadow look. */
.project-card {
  --bs-card-border-radius: 0;
  --bs-card-inner-border-radius: 0;
  position: relative;
  display: flex;
  border-radius: 0;
  border: 1px solid var(--border-color);
  border-left: 3px solid transparent;
  box-shadow: none;
  /* Fallback surface: keeps the white overlay text readable when a project has
     no image, or when its image fails to load. */
  background: linear-gradient(160deg, #2b3446 0%, #1e2532 100%);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}
.project-card:hover {
  border-left-color: var(--primary-color);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
}

.project-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 0;
  transition: transform 0.5s;
  filter: saturate(1.1) contrast(1.05);
  /* Hides the alt text / broken-image glyph if the source 404s. */
  color: transparent;
}
.project-image.is-broken { display: none; }
.project-card:hover .project-image { transform: scale(1.06); }

/* Brand tint plus a bottom-up scrim, painted over the image so the text keeps
   its contrast wherever the image happens to be light. */
.project-tint {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to top, rgba(30, 37, 50, 0.94) 0%, rgba(30, 37, 50, 0.72) 45%, rgba(30, 37, 50, 0.28) 100%),
    linear-gradient(135deg, rgba(102, 204, 138, 0.18), rgba(55, 124, 251, 0.18));
  pointer-events: none;
}

.project-content {
  position: relative;
  z-index: 1;
  display: flex;
  /* Grow to fill the card (Bootstrap's .card is a column flex container) so the
     text stays anchored to the bottom of the tile, as the scrim expects. */
  flex: 1 1 auto;
  flex-direction: column;
  justify-content: flex-end;
  width: 100%;
  min-height: 240px;
  padding: 1rem;
}
@media (min-width: 768px) {
  .project-content { padding: 1.5rem; }
}

.project-description { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

.project-tech-badge {
  display: inline-block;
  padding: 0.2rem 0.55rem;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: white;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.project-btn-primary {
  background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
  color: white !important;
  border: none;
  border-radius: 0;
  font-weight: 600;
}
.project-btn-primary:hover { color: white !important; filter: brightness(1.08); }
.project-btn-ghost {
  background: rgba(255, 255, 255, 0.12);
  color: white !important;
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 0;
  font-weight: 600;
}
.project-btn-ghost:hover { background: rgba(255, 255, 255, 0.22); color: white !important; }

/* Buttons fade in on hover, but stay in the layout so the card never reflows —
   and stay visible for touch and keyboard users. */
.learn-more-btn { opacity: 0; transform: translateY(6px); transition: all 0.25s; }
.project-card:hover .learn-more-btn,
.learn-more-btn:focus-visible { opacity: 1; transform: translateY(0); }
@media (hover: none), (max-width: 768px) {
  .learn-more-btn { opacity: 1; transform: translateY(0); }
}
</style>
