---
/**
 * Decorative line art behind a page or a homepage band: a few thin outlined
 * shapes in the brand colours. Each page type picks its own `variant` so the
 * pages don't all look alike.
 *
 * The drawing spans the full width of its nearest positioned ancestor, which
 * must clip it (`overflow: hidden`) — see `.yas-page` and `.home-band` in
 * global.css. Each variant is two groups: `right` is pinned to the right edge
 * (its x coordinates count back from that edge, so they are negative or small)
 * and `left` to the left edge, so the shapes reach both sides at any width.
 *
 * Every variant keeps its large shapes on the right and its small ones in the
 * left gutter, because the text column starts at the left: a hairline may pass
 * behind a display title, but it should not run through body text.
 */
const art = {
  rings: {
    right: `
      <circle class="bd-navy" cx="-200" cy="240" r="480" />
      <circle class="bd-green" cx="-200" cy="240" r="380" />
      <rect class="bd-blue" x="-260" y="900" width="260" height="260" transform="rotate(45 -130 1030)" />`,
    left: `
      <rect class="bd-navy" x="-150" y="320" width="340" height="340" transform="rotate(45 20 490)" />`,
  },
  diamonds: {
    right: `
      <rect class="bd-navy" x="-580" y="-80" width="720" height="720" transform="rotate(45 -220 280)" />
      <rect class="bd-green" x="-490" y="10" width="540" height="540" transform="rotate(45 -220 280)" />
      <rect class="bd-blue" x="-400" y="100" width="360" height="360" transform="rotate(45 -220 280)" />`,
    left: `
      <rect class="bd-navy" x="-110" y="860" width="300" height="300" transform="rotate(45 40 1010)" />
      <rect class="bd-green" x="-50" y="920" width="180" height="180" transform="rotate(45 40 1010)" />`,
  },
  grid: {
    right: `
      <rect class="bd-navy" x="-480" y="-60" width="260" height="260" />
      <rect class="bd-green" x="-350" y="70" width="260" height="260" />
      <rect class="bd-blue" x="-220" y="200" width="260" height="260" />
      <rect class="bd-navy" x="-90" y="330" width="260" height="260" />`,
    left: `
      <rect class="bd-navy" x="-120" y="780" width="220" height="220" />
      <rect class="bd-green" x="-10" y="890" width="220" height="220" />`,
  },
  squares: {
    right: `
      <rect class="bd-navy" x="-540" y="-120" width="660" height="660" />
      <rect class="bd-green" x="-440" y="-120" width="560" height="560" />
      <rect class="bd-blue" x="-340" y="-120" width="460" height="460" />`,
    left: `
      <rect class="bd-navy" x="-90" y="840" width="200" height="200" />
      <rect class="bd-green" x="-90" y="900" width="140" height="140" />`,
  },
  arcs: {
    right: `
      <circle class="bd-navy" cx="0" cy="0" r="640" />
      <circle class="bd-green" cx="0" cy="0" r="480" />
      <circle class="bd-blue" cx="0" cy="0" r="320" />`,
    left: `
      <circle class="bd-navy" cx="0" cy="1100" r="230" />
      <circle class="bd-green" cx="0" cy="1100" r="140" />`,
  },
  lines: {
    right: `
      <path class="bd-navy" d="M-680 -40 L40 680" />
      <path class="bd-green" d="M-540 -40 L40 540" />
      <path class="bd-blue" d="M-400 -40 L40 400" />
      <path class="bd-navy" d="M-260 -40 L40 260" />
      <circle class="bd-green" cx="-140" cy="520" r="150" />`,
    left: `
      <path class="bd-navy" d="M-40 820 L220 1080" />
      <path class="bd-blue" d="M-40 960 L120 1120" />`,
  },
};

export type BackdropVariant = keyof typeof art;

interface Props {
  variant?: BackdropVariant;
}

const { variant = 'rings' } = Astro.props;
---

<svg class="yas-backdrop" width="100%" height="1400" fill="none" stroke-width="1.5" aria-hidden="true" focusable="false">
  <g class="bd-group bd-left" set:html={art[variant].left} />
  <svg x="100%" overflow="visible">
    <g class="bd-group" set:html={art[variant].right} />
  </svg>
</svg>
