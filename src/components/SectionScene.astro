---
/**
 * A small outline diagram for one of the homepage's bands.
 * The scene itself lives in src/scripts/sectionScenes.ts; this component only
 * provides the canvas and wires it to the nearest `.reveal-section`, whose
 * `is-active` state starts the diagram drawing itself (see sectionScenes.ts).
 *
 * The scene's words are drawn into canvas textures, not DOM nodes, so they
 * can't be translated by the page's markup. They ride along in a
 * `data-scene-labels` attribute instead and are read back by the client script.
 */
import type { SceneName } from '../scripts/sectionScenes';
import { defaultLang, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  name: SceneName;
  lang?: Lang;
}

const { name, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const labelsByScene: Record<SceneName, Record<string, string>> = {
  workflow: {
    discovery: t('home.how.discovery'),
    build: t('home.how.build'),
    review: t('home.how.review'),
    ship: t('home.how.ship'),
  },
  ownership: {
    you: t('scene.you'),
    developers: t('scene.developers'),
    accountManager: t('scene.accountManager'),
    noHandoffs: t('scene.noHandoffs'),
  },
  blog: {},
};
---

<div class="section-scene">
  <canvas
    data-section-scene={name}
    data-scene-labels={JSON.stringify(labelsByScene[name])}
    aria-hidden="true"
  ></canvas>
</div>

<style>
  .section-scene {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    aspect-ratio: 8 / 5;
  }

  .section-scene canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import type { SceneLabels, SceneName } from '../scripts/sectionScenes';

  // three.js and the scenes load only once a diagram is about to scroll into
  // view, so none of it is on the critical path. (A diagram hidden on small
  // screens never intersects, so phones never load it.) With reduced motion
  // the scenes draw themselves fully, without animating (see sceneKit.ts).
  const canvases = Array.from(document.querySelectorAll<HTMLCanvasElement>('[data-section-scene]'));

  function start(canvas: HTMLCanvasElement) {
    const section = canvas.closest('.reveal-section') ?? canvas;
    let labels: SceneLabels = {};
    try {
      labels = JSON.parse(canvas.dataset.sceneLabels ?? '{}') as SceneLabels;
    } catch {
      // Fall through with no labels — each scene has an English default.
    }
    // Labels are drawn to 2D canvases, so wait for the webfont rather than
    // baking a fallback face into the textures.
    const ready = document.fonts ? document.fonts.ready : Promise.resolve();
    Promise.all([import('../scripts/sectionScenes'), ready])
      .then(([{ initSectionScene }]) =>
        initSectionScene(canvas, canvas.dataset.sectionScene as SceneName, section, labels)
      )
      // The section's text carries the message on its own, so fail quietly.
      .catch((error) => console.warn('Section scene unavailable:', error));
  }

  if (canvases.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.unobserve(entry.target);
          start(entry.target as HTMLCanvasElement);
        }),
      { rootMargin: '300px 0px' }
    );
    canvases.forEach((canvas) => observer.observe(canvas));
  }
</script>
