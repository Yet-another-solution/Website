                            },
                            {
                              "type": "text",
                              "id": "oQ891",
                              "x": 24.36,
                              "y": -1,
                              "name": "Why we process it",
                              "fill": "#333c4d",
                              "content": "Why we process it",
                              "lineHeight": 1.3,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 32,
                              "fontWeight": "600"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "XaavG",
                          "x": 0,
                          "y": 761.22,
                          "name": "Request data is processed to deliver the",
                          "context": "p",
                          "fill": "#1e2532",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container(720)",
                          "height": 126.63,
                          "content": "Request data is processed to deliver the site and keep it secure, and emails are processed to answer you. The legal basis for both is our legitimate interest (GDPR Article 6(1)(f)); if your enquiry is about a contract with us, it is Article 6(1)(b).",
                          "lineHeight": 1.8,
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 17.6,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "t0Ip7",
                          "x": 0,
                          "y": 911.84,
                          "name": "h2",
                          "context": "h2",
                          "width": "fill_container(720)",
                          "height": 41.59,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "j7c9S",
                              "x": 0,
                              "y": 11.2,
                              "name": "Icon",
                              "fill": "#66cc8a",
                              "content": "▶",
                              "lineHeight": 1.3,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 19.2,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "noqLx",
                              "x": 24.36,
                              "y": -1,
                              "name": "Who receives it",
                              "fill": "#333c4d",
                              "content": "Who receives it",
                              "lineHeight": 1.3,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 32,
                              "fontWeight": "600"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "rxJ8W",
                          "x": 0,
                          "y": 961.44,
                          "name": "Cloudflare, as our hosting provider, and",
                          "context": "p",
                          "fill": "#1e2532",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container(720)",
                          "height": 126.63,
                          "content": "Cloudflare, as our hosting provider, and Google, whose Google Workspace service handles our email. Both act on our instructions as data processors. We do not sell personal data or share it with anyone else.",
                          "lineHeight": 1.8,
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 17.6,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "ifzLN",
                          "x": 0,
                          "y": 1112.06,
                          "name": "h2",
                          "context": "h2",
                          "width": "fill_container(720)",
                          "height": 41.59,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "J9zzRI",
                              "x": 0,
                              "y": 11.2,
                              "name": "Icon",
                              "fill": "#66cc8a",
                              "content": "▶",
                              "lineHeight": 1.3,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 19.2,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "uk85u",
                              "x": 24.36,
                              "y": -1,
                              "name": "Transfers outside the EU",
                              "fill": "#333c4d",
                              "content": "Transfers outside the EU",
                              "lineHeight": 1.3,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 32,
                              "fontWeight": "600"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n7Io7",
                          "x": 0,
                          "y": 1161.65,
                          "name": "Cloudflare and Google are companies base",
                          "context": "p",
                          "fill": "#1e2532",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container(720)",
                          "height": 126.63,
                          "content": "Cloudflare and Google are companies based in the United States, so personal data may be processed outside the EU/EEA. Such transfers are covered by the EU–US Data Privacy Framework and by the European Commission’s standard contractual clauses.",
                          "lineHeight": 1.8,
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 17.6,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "gLq7A",
                          "x": 0,
                          "y": 1312.28,
                          "name": "h2",
                          "context": "h2",
                          "width": "fill_container(720)",
                          "height": 41.59,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "HMPUH",
                              "x": 0,
                              "y": 11.2,
                              "name": "Icon",
                              "fill": "#66cc8a",
                              "content": "▶",
