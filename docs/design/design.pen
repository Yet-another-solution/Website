                      ],
                      "children": [
                        {
                          "type": "frame",
                          "id": "GNFys",
                          "name": "Article",
                          "width": 760,
                          "layout": "vertical",
                          "gap": 28,
                          "children": [
                            {
                              "type": "text",
                              "id": "VXAsx",
                              "name": "Heading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Introduction",
                              "lineHeight": 1.2,
                              "fontFamily": "Rubik Mono One",
                              "fontSize": 28,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "dsDhi",
                              "name": "Paragraph",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Blazor is Microsoft’s web framework that allows developers to build interactive web applications using C# instead of JavaScript. This guide will get you started with your first Blazor application.",
                              "lineHeight": 1.8,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "m99kJi",
                              "name": "Heading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "What is Blazor?",
                              "lineHeight": 1.2,
                              "fontFamily": "Rubik Mono One",
                              "fontSize": 28,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "kpObM",
                              "name": "Paragraph",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Blazor is a free and open-source web framework that enables developers to create interactive web UIs using C#. It offers two hosting models:",
                              "lineHeight": 1.8,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "NELVT",
                              "name": "Bullet",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Blazor Server: Runs on the server with UI updates sent over SignalR",
                              "lineHeight": 1.7,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 15.2,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "fTPqz",
                              "name": "Bullet",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Blazor WebAssembly: Runs entirely in the browser using WebAssembly",
                              "lineHeight": 1.7,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 15.2,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "T5oBSW",
                              "name": "Heading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Why Choose Blazor?",
                              "lineHeight": 1.2,
                              "fontFamily": "Rubik Mono One",
                              "fontSize": 28,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "bJ1qk",
                              "name": "Bullet",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Unified Development Stack: use C# for both client and server-side development, reducing context switching between languages.",
                              "lineHeight": 1.7,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 15.2,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "bLZoY",
                              "name": "Bullet",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Rich Component Model: build reusable UI components with clear separation of concerns.",
                              "lineHeight": 1.7,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 15.2,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "U9l6F",
                              "name": "Bullet",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Strong Typing: get compile-time error checking and excellent IntelliSense support.",
                              "lineHeight": 1.7,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 15.2,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "fPEO8",
                              "name": "Heading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Quick Start",
                              "lineHeight": 1.2,
                              "fontFamily": "Rubik Mono One",
                              "fontSize": 28,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "ielBa",
                              "name": "Subheading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Prerequisites",
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "n6MDSL",
                              "name": "Bullet",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  .NET 8 SDK or later",
                              "lineHeight": 1.7,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 15.2,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "AXxtb",
                              "name": "Bullet",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Visual Studio 2022 or Visual Studio Code",
                              "lineHeight": 1.7,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 15.2,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "SBSOC",
                              "name": "Subheading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Create Your First Project",
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "700"
                            },
                            {
                              "type": "frame",
                              "id": "Dq5h4",
                              "name": "Code Block",
                              "width": "fill_container",
                              "fill": "#333c4d",
                              "layout": "vertical",
                              "padding": 24,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "H1YCWe",
                                  "name": "Code",
                                  "fill": "#e5e2e1",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "dotnet new blazorserver -o MyBlazorApp",
                                  "lineHeight": 1.6,
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 13.6,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "wiDkS",
                              "name": "Paragraph",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Navigate to https://localhost:5001 to see your running Blazor application.",
                              "lineHeight": 1.8,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "sjmON",
                              "name": "Heading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Basic Blazor Component",
                              "lineHeight": 1.2,
                              "fontFamily": "Rubik Mono One",
                              "fontSize": 28,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "HVzGH",
                              "name": "Paragraph",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Here’s a simple counter component:",
                              "lineHeight": 1.8,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "frame",
                              "id": "sOEEF",
                              "name": "Code Block",
                              "width": "fill_container",
                              "fill": "#333c4d",
                              "layout": "vertical",
                              "padding": 24,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "SOx0I",
                                  "name": "Code",
                                  "fill": "#e5e2e1",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "@page \"/counter\"\n<h1>Counter</h1>\n<p>Current count: @currentCount</p>\n<button class=\"btn btn-primary\" @onclick=\"IncrementCount\">Click me</button>\n\n@code {\n    private int currentCount = 0;\n\n    private void IncrementCount()\n    {\n        currentCount++;\n    }\n}",
                                  "lineHeight": 1.6,
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 13.6,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "IJf0l",
                              "name": "Heading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Key Features",
                              "lineHeight": 1.2,
                              "fontFamily": "Rubik Mono One",
                              "fontSize": 28,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "wHXnp",
                              "name": "Bullet",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Component-based architecture for building modular UIs",
                              "lineHeight": 1.7,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 15.2,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "aD6a0",
                              "name": "Bullet",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Data binding with automatic UI updates",
                              "lineHeight": 1.7,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 15.2,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "Mh0Nl",
                              "name": "Bullet",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Event handling with C# methods",
                              "lineHeight": 1.7,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 15.2,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "WNvql",
                              "name": "Bullet",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "•  Dependency injection built-in",
                              "lineHeight": 1.7,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 15.2,
                              "fontWeight": "normal"
                            },
                            {
