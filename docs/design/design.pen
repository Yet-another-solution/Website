                              "children": [
                                {
                                  "type": "text",
                                  "id": "zniOe",
                                  "name": "Hack the Flag is a competition for anyon",
                                  "context": "p",
                                  "fill": "#1e2532",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 94.97,
                                  "content": "Hack the Flag is a competition for anyone who likes to solve ciphers. The competition aims to promote the world of cryptography and encourage people to learn more about it.",
                                  "lineHeight": 1.8,
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 17.6,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "TDJZw",
                                  "name": "The competition tests your skills in sol",
                                  "context": "p",
                                  "fill": "#1e2532",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 126.63,
                                  "content": "The competition tests your skills in solving ciphers and how quickly you can do it. Your goal is to solve as many ciphers as possible and earn as many points as you can. The output of each cipher will be a flag in the format <HTF-this_is_flag/>.",
                                  "lineHeight": 1.8,
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 17.6,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
