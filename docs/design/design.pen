                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "WBKDy",
                              "name": "Heading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "What we collect",
                              "lineHeight": 1.2,
                              "fontFamily": "Rubik Mono One",
                              "fontSize": 28,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "rGa9I",
                              "name": "Paragraph",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "The site is hosted by Cloudflare. When you open a page, Cloudflare processes technical request data on our behalf: your IP address, browser type, the page requested and the time. If you email us, we receive your email address and whatever you choose to write.",
                              "lineHeight": 1.8,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "K5SkpZ",
                              "name": "Heading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "What we do not do",
                              "lineHeight": 1.2,
                              "fontFamily": "Rubik Mono One",
                              "fontSize": 28,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "uMbcP",
                              "name": "Paragraph",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "This site sets no cookies and uses no analytics, tracking or advertising. It has no forms, accounts or newsletter. Fonts, scripts and images are served from our own domain, so opening a page contacts no company other than our hosting provider.",
                              "lineHeight": 1.8,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "c1t52C",
                              "name": "Heading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Why we process it",
                              "lineHeight": 1.2,
                              "fontFamily": "Rubik Mono One",
                              "fontSize": 28,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "hWxyj",
                              "name": "Paragraph",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Request data is processed to deliver the site and keep it secure, and emails are processed to answer you. The legal basis for both is our legitimate interest (GDPR Article 6(1)(f)); if your enquiry is about a contract with us, it is Article 6(1)(b).",
                              "lineHeight": 1.8,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "ssFGA",
                              "name": "Heading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Who receives it",
                              "lineHeight": 1.2,
                              "fontFamily": "Rubik Mono One",
                              "fontSize": 28,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "NxS3V",
                              "name": "Paragraph",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Cloudflare, as our hosting provider, and Google, whose Google Workspace service handles our email. Both act on our instructions as data processors. We do not sell personal data or share it with anyone else.",
                              "lineHeight": 1.8,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "NUiEY",
                              "name": "Heading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Transfers outside the EU",
                              "lineHeight": 1.2,
                              "fontFamily": "Rubik Mono One",
                              "fontSize": 28,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "vDib5",
                              "name": "Paragraph",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Cloudflare and Google are companies based in the United States, so personal data may be processed outside the EU/EEA. Such transfers are covered by the EU–US Data Privacy Framework and by the European Commission’s standard contractual clauses.",
                              "lineHeight": 1.8,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "JCr7Z",
                              "name": "Heading",
                              "fill": "#333c4d",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How long we keep it",
                              "lineHeight": 1.2,
                              "fontFamily": "Rubik Mono One",
                              "fontSize": 28,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "eixRH",
                              "name": "Paragraph",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "We keep emails for as long as it takes to handle your enquiry, and longer only where the law requires it, for example for bookkeeping. We keep no visitor logs of our own; Cloudflare retains request data only for a short time, according to its own retention rules.",
                              "lineHeight": 1.8,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "g8sif4",
                              "name": "Paragraph",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "You can ask for access to the personal data we hold about you, have it corrected or deleted, object to or restrict its processing, and receive it in a portable format. We make no automated decisions about you. To use your rights, write to contact@y-a-s.net.",
                              "lineHeight": 1.8,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "M53gT",
                              "name": "Paragraph",
                              "fill": "#1e2532",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "If you think we handle your data wrongly, you can complain to the Danish Data Protection Agency (Datatilsynet): datatilsynet.dk.",
                              "lineHeight": 1.8,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
