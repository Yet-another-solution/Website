                          "id": "y5vBtQ",
                          "x": 0,
                          "y": 1762.31,
                          "name": "If you think we handle your data wrongly",
                          "context": "p",
                          "fill": "#1e2532",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container(720)",
                          "height": 63.31,
                          "content": "If you think we handle your data wrongly, you can complain to the Danish Data Protection Agency (Datatilsynet): datatilsynet.dk.",
