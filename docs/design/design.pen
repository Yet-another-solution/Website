                                  "fill": "#1e2532",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 94.97,
                                  "content": "Súťaž preverí, ako dobre a ako rýchlo dokážete šifry rozlúsknuť. Vaším cieľom je vyriešiť čo najviac šifier a získať čo najviac bodov. Výstupom každej šifry je vlajka v tvare <HTF-this_is_flag/>.",
                                  "lineHeight": 1.8,
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 17.6,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
