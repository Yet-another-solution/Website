                            },
                            {
                              "type": "text",
                              "id": "luCUW",
                              "x": 24.36,
                              "y": -1,
                              "name": "Your rights",
                              "fill": "#333c4d",
                              "content": "Your rights",
                              "lineHeight": 1.3,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 32,
                              "fontWeight": "600"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "x0aJk2",
                          "x": 0,
                          "y": 1562.09,
                          "name": "You can ask for access to the personal d",
                          "context": "p",
                          "fill": "#1e2532",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container(720)",
                          "height": 126.63,
                          "content": "You can ask for access to the personal data we hold about you, have it corrected or deleted, object to or restrict its processing, and receive it in a portable format. We make no automated decisions about you. To use your rights, write to contact@y-a-s.net.",
                          "lineHeight": 1.8,
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 17.6,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
