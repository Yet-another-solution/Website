                          "x": 0,
                          "y": 1657.06,
                          "name": "Môžete požiadať o prístup k osobným údaj",
                          "context": "p",
                          "fill": "#1e2532",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container(720)",
                          "height": 158.28,
                          "content": "Môžete požiadať o prístup k osobným údajom, ktoré o vás máme, o ich opravu alebo vymazanie, namietať proti ich spracúvaniu alebo ho nechať obmedziť a získať ich v prenosnom formáte. Nerobíme o vás žiadne automatizované rozhodnutia. Svoje práva uplatníte e-mailom na contact@y-a-s.net.",
                          "lineHeight": 1.8,
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 17.6,
                          "fontWeight": "normal"
                        },
