                              "x": 24.36,
                              "y": -1,
                              "name": "Ako dlho údaje uchovávame",
                              "fill": "#333c4d",
                              "content": "Ako dlho údaje uchovávame",
                              "lineHeight": 1.3,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 32,
                              "fontWeight": "600"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "uHWUG",
                          "x": 0,
                          "y": 1425.19,
                          "name": "E-maily uchovávame tak dlho, ako je potr",
                          "context": "p",
                          "fill": "#1e2532",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container(720)",
                          "height": 158.28,
                          "content": "E-maily uchovávame tak dlho, ako je potrebné na vybavenie vašej otázky, a dlhšie iba vtedy, keď to vyžaduje zákon, napríklad pre účtovníctvo. Vlastné záznamy o návštevníkoch nevedieme; Cloudflare uchováva údaje o požiadavkách len krátko, podľa vlastných pravidiel uchovávania.",
                          "lineHeight": 1.8,
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 17.6,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
